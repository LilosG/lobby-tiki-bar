---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  heroImage?: string;
  pageSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image = '/images/venue-interior-1.jpg',
  noindex = false,
  heroImage,
  pageSchema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const ogImageURL   = image.startsWith('http') ? image : `${SITE.url}${image}`;

const businessNode = {
  '@type': SITE.schema.type,
  '@id': SITE.schema.id,
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  telephone: SITE.phone.tel,
  image: SITE.schema.image,
  hasMenu: SITE.schema.menuUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.state,
    postalCode: SITE.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.schema.geo.lat,
    longitude: SITE.schema.geo.lng,
  },
  priceRange: SITE.schema.priceRange,
  servesCuisine: SITE.schema.servesCuisine,
  hasMap: SITE.address.mapsUrl,
  sameAs: Object.values(SITE.social),
  openingHoursSpecification: SITE.hours
    .filter(h => h.open)
    .map(h => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${h.day}`,
      opens: h.opens,
      closes: h.closes,
    })),
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  description: SITE.description,
  publisher: { '@id': SITE.schema.id },
};

const webpageNode = {
  '@type': 'WebPage',
  '@id': `${canonicalURL}#webpage`,
  url: canonicalURL.toString(),
  name: title,
  description,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': SITE.schema.id },
};

const pageNodes = pageSchema
  ? Array.isArray(pageSchema) ? pageSchema : [pageSchema]
  : [];

const fullSchema = {
  '@context': 'https://schema.org',
  '@graph': [businessNode, websiteNode, webpageNode, ...pageNodes],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:site_name"   content={SITE.name} />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Dancing+Script:wght@600;700&family=DM+Sans:wght@300;400;500;600&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet" />

    {heroImage && (
      <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(fullSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
