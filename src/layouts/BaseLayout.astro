---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import MobileStickyBar from '../components/MobileStickyBar.astro';

const SITE = (await getEntry('siteSettings', 'sitesettings'))!.data;

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  heroImage?: string;
  pageSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image = '/images/venue-interior-1.jpg',
  noindex = false,
  heroImage,
  pageSchema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const ogImageURL   = image.startsWith('http') ? image : `${SITE.url}${image}`;

// Human-readable labels for URL segments used in breadcrumb parent nodes
const SEGMENT_LABELS: Record<string, string> = {
  'menu':           'Menu',
  'happy-hour':     'Happy Hour',
  'brunch':         'Brunch',
  'events':         'Events',
  'private-events': 'Private Events',
  'the-lobby':      'The Venue',
  'about':          'About',
  'blog':           'Blog',
  'contact':        'Contact',
  'reservations':   'Reservations',
};

// ─── Schema nodes ─────────────────────────────────────────────────────────────

const businessNode = {
  '@type': SITE.schema.type,
  '@id': SITE.schema.id,
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  telephone: SITE.phone.tel,
  image: SITE.schema.image,
  hasMenu: SITE.schema.menuUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.state,
    postalCode: SITE.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.schema.geo.lat,
    longitude: SITE.schema.geo.lng,
  },
  priceRange: SITE.schema.priceRange,
  servesCuisine: SITE.schema.servesCuisine,
  hasMap: SITE.address.mapsUrl,
  sameAs: Object.values(SITE.social),
  openingHoursSpecification: (SITE.hours ?? [])
    .filter(h => h.open)
    .map(h => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${h.day}`,
      opens: h.opens,
      closes: h.closes,
    })),
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  description: SITE.description,
  publisher: { '@id': SITE.schema.id },
};

const webpageNode = {
  '@type': 'WebPage',
  '@id': `${canonicalURL}#webpage`,
  url: canonicalURL.toString(),
  name: title,
  description,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': SITE.schema.id },
};

// BreadcrumbList — auto-derived from URL pathname, not emitted on homepage
const pathSegments = canonicalURL.pathname.split('/').filter(Boolean);
const pageTitle    = title.split('|')[0].trim();

const breadcrumbNode = pathSegments.length > 0
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${SITE.url}/`,
        },
        ...pathSegments.map((seg, i) => {
          const cumulativePath = '/' + pathSegments.slice(0, i + 1).join('/') + '/';
          const isLeaf         = i === pathSegments.length - 1;
          const name           = isLeaf
            ? pageTitle
            : (SEGMENT_LABELS[seg] ?? seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()));
          return {
            '@type': 'ListItem',
            position: i + 2,
            name,
            item: `${SITE.url}${cumulativePath}`,
          };
        }),
      ],
    }
  : null;

// Page-specific schema nodes passed from individual pages
const pageNodes  = pageSchema
  ? Array.isArray(pageSchema) ? pageSchema : [pageSchema]
  : [];

// Assemble @graph — order: business, website, webpage, page-specific, breadcrumb
const graphNodes = [businessNode, websiteNode, webpageNode, ...pageNodes];
if (breadcrumbNode) graphNodes.push(breadcrumbNode);

const fullSchema = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:site_name"   content={SITE.name} />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />

    <link rel="alternate" type="application/rss+xml" title="The Lobby Tiki Bar — Blog" href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Dancing+Script:wght@600;700&family=DM+Sans:wght@300;400;500;600&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet" />

    {heroImage && (
      <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(fullSchema)} />
    <Analytics />

    <!--
      Business hours are keyed by day name and rendered the same on every
      request (fine — they don't change). "Today" is different: computing
      it in frontmatter (new Date().getDay()) runs once at BUILD time on
      Vercel's server, and gets frozen into the static HTML until the next
      deploy — so it silently goes stale and shows whatever day it was last
      built on, regardless of who's viewing the page or when.

      Fix: ship the full week's hours as data, and compute "today" in the
      visitor's browser, on every page load, using the business's actual
      timezone (Oceanside, CA) rather than build time or the visitor's own
      device timezone (which would give a wrong answer near midnight for
      anyone browsing from outside Pacific time).

      Usage in templates:
        - <span data-hours-today>fallback</span>      -> textContent set to today's hours
        - <li data-day="Monday" data-today-class="..." data-default-class="...">
          -> className set to whichever matches today
    -->
    <script type="application/json" id="lobby-hours-data" set:html={JSON.stringify(SITE.hours ?? [])} />
    <script is:inline>
      (function () {
        function getTodayName() {
          try {
            return new Intl.DateTimeFormat('en-US', {
              timeZone: 'America/Los_Angeles',
              weekday: 'long',
            }).format(new Date());
          } catch {
            const days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
            return days[new Date().getDay()];
          }
        }

        function syncTodayHours() {
          const dataEl = document.getElementById('lobby-hours-data');
          if (!dataEl) return;
          let hours;
          try {
            hours = JSON.parse(dataEl.textContent);
          } catch {
            return;
          }
          const todayName = getTodayName();
          const todayEntry = hours.find((h) => h.day === todayName);
          const todayText = todayEntry ? todayEntry.hours : 'Closed';

          document.querySelectorAll('[data-hours-today]').forEach((el) => {
            el.textContent = todayText;
          });

          document.querySelectorAll('[data-day]').forEach((el) => {
            const isToday = el.getAttribute('data-day') === todayName;
            const cls = isToday ? el.getAttribute('data-today-class') : el.getAttribute('data-default-class');
            if (cls !== null) el.className = cls;
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncTodayHours);
        } else {
          syncTodayHours();
        }
      })();
    </script>
</head>
  <body class="pb-[60px] lg:pb-0">
    <slot />
    <MobileStickyBar />
    <ConsentBanner siteName="The Lobby Tiki Bar" />
  </body>
</html>
