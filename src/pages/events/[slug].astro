---
import { Image } from 'astro:assets';
import { RECURRING_EVENTS } from '../../data/events';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return RECURRING_EVENTS.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;

const eventSchema = {
  '@type': 'Event',
  '@id': `${SITE.url}/events/${event.slug}/#event`,
  name: event.name,
  description: event.description,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: SITE.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.city,
      addressRegion: SITE.address.state,
      postalCode: SITE.address.zip,
      addressCountry: 'US',
    },
  },
  organizer: { '@id': SITE.schema.id },
};
---

<BaseLayout
  title={`${event.name} | The Lobby Tiki Bar Oceanside`}
  description={event.description}
  image={`/images/${event.image.src.split('/').pop()}`}
  heroImage={event.image.src}
  pageSchema={eventSchema}
>
  <Nav />

  <section class="relative min-h-[70vh] flex items-end overflow-hidden">
    <div class="absolute inset-0">
      <Image src={event.image} alt={`${event.name} at The Lobby Tiki Bar Oceanside`}
        class="w-full h-full object-cover" width={1800} height={600} loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-espresso)] via-[var(--color-espresso)]/60 to-transparent"></div>
    </div>
    <div class="relative z-10 w-full"><div class="max-w-7xl mx-auto px-8 sm:px-16 pb-20">
      <span class="inline-block bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-4 py-2 mb-6">
        {event.highlight}
      </span>
      <h1 class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl lg:text-7xl text-[var(--color-sand)] leading-tight mb-4">
        {event.name}
      </h1>
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-sand)] opacity-60 text-sm tracking-widest uppercase">
        {event.day} &bull; {event.time}
      </p>
    </div>
  </section>

  <section class="py-24 px-6">
    <div class="max-w-3xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
        <div>
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">About This Event</p>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed text-lg">{event.description}</p>
        </div>
        <div class="space-y-6">
          <div class="border border-white/10 p-6">
            <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">When</p>
            <p class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)]">{event.day}</p>
            <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 text-sm mt-1">{event.time}</p>
          </div>
          <div class="border border-white/10 p-6">
            <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">Where</p>
            <p class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)]">The Lobby Tiki Bar</p>
            <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 text-sm mt-1">408 Pier View Way<br />Oceanside, CA 92054</p>
          </div>
          <div class="border border-white/10 p-6">
            <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">The Deal</p>
            <p class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-amber)]">{event.highlight}</p>
          </div>
        </div>
      </div>
    </div></div>
  </section>

  <CTASection
    title="Join Us"
    subtitle="Reserve your table or walk in. Open Tuesday through Sunday."
    primaryLabel="Reserve a Table"
    primaryHref={SITE.reservations.url}
    secondaryLabel="See All Events"
    secondaryHref="/events"
  />

  <Footer />
</BaseLayout>
