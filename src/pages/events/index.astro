---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import TrustBar from '../../components/TrustBar.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import { SITE } from '../../data/site';
import { RECURRING_EVENTS, UPCOMING_EVENTS } from '../../data/events';

import venueCurtainEdit from '../../assets/images/venue-curtain-edit.jpg';
import venueRoomFull    from '../../assets/images/venue-room-full.jpg';
---

<BaseLayout
  title="Events Oceanside | The Lobby Tiki Bar | Tiki Taco Tuesday & Weekly Specials"
  description="Weekly events at The Lobby Tiki Bar in Oceanside CA. Tiki Taco Tuesdays, happy hour specials, and private events. 408 Pier View Way inside The Brick Hotel."
  image="/images/venue-interior-1.jpg"
>
  <Nav />

  <PageHero
    label="Weekly &amp; Special"
    title="Events at The Lobby"
    subtitle="Tiki Taco Tuesdays, happy hour specials, and more. Something happening every week on Pier View Way."
    image={venueCurtainEdit}
    imageAlt="Events at The Lobby Tiki Bar Oceanside CA — tiki atmosphere and weekly events"
    overlay="gradient"
  />

  <!-- WEEKLY EVENTS -->
  <TrustBar />
  <section class="py-24 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">Every Week</p>
        <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)]">Weekly Events</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {RECURRING_EVENTS.map((event) => (
          <a href={`/events/${event.slug}`}
            class="group relative overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/30 transition-colors block">
            <div class="aspect-video overflow-hidden">
              <Image src={event.image} alt={`${event.name} at The Lobby Tiki Bar Oceanside`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-70"
                width={800} height={450} />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-espresso)] via-[var(--color-espresso)]/60 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8">
              <span class="inline-block bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-3 py-1 mb-3">
                {event.highlight}
              </span>
              <h3 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl text-[var(--color-sand)] mb-2">{event.name}</h3>
              <p class="font-[family-name:var(--font-stamp)] text-[var(--color-sand)] opacity-60 text-xs tracking-wider uppercase mb-3">{event.day} &bull; {event.time}</p>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm leading-relaxed">{event.description}</p>
              <p class="mt-4 font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase group-hover:underline">View Details &rarr;</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {UPCOMING_EVENTS.length > 0 && (
    <section class="py-20 bg-[var(--color-espresso-light)]/20 px-6">
      <div class="max-w-7xl mx-auto">
        <h2 class="font-[family-name:var(--font-display)] text-4xl text-[var(--color-sand)] mb-12">Upcoming Events</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {UPCOMING_EVENTS.map((event) => (
            <div class="border border-white/10 p-6 hover:border-[var(--color-amber)]/30 transition-colors">
              <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">{event.date}</p>
              <h3 class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)] mb-2">{event.name}</h3>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 text-sm mb-4">{event.description}</p>
              {event.ticketUrl && (
                <a href={event.ticketUrl} target="_blank" rel="noopener noreferrer"
                  class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase hover:text-[var(--color-sand)] transition-colors">
                  Get Tickets &rarr;
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- SEO COPY -->
  <section class="py-24 px-6 bg-[var(--color-jungle)]/20">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">408 Pier View Way, Oceanside</p>
        <h2 class="font-[family-name:var(--font-display)] text-4xl text-[var(--color-sand)] mb-6">Weekly Events in Oceanside, CA</h2>
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-4">
          The Lobby Tiki Bar keeps the week moving. Every Tuesday is Tiki Taco Tuesday &mdash; 30% off all rum drinks from open to close, paired with island-inspired tacos. Monday through Friday we run happy hour with discounted cocktails, beer, wine, and bites.
        </p>
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-8">
          Inside The Brick Hotel on Pier View Way, steps from the Oceanside Pier. The kind of weekly ritual a neighborhood bar is supposed to provide.
        </p>
        <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer"
          class="inline-block bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-sand)] transition-colors">
          Reserve a Table
        </a>
      </div>
      <div class="relative overflow-hidden">
        <Image src={venueRoomFull}
          alt="The Lobby Tiki Bar Oceanside CA interior during weekly events"
          class="w-full aspect-[4/3] object-cover" width={900} height={675} />
        <div class="absolute -bottom-4 -right-4 w-full h-full border border-[var(--color-amber)]/20 -z-10"></div>
      </div>
    </div>
  </section>

  <!-- PRIVATE EVENTS BAND -->
  <section class="relative min-h-[40vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-[var(--color-espresso-light)]/30"></div>
    <div class="relative z-10 text-center px-6 py-20 max-w-2xl mx-auto">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">Group Bookings</p>
      <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)] mb-6">Host a Private Event</h2>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 leading-relaxed mb-10 max-w-lg mx-auto">
        Book The Lobby for your next birthday, corporate event, bar buyout, or rehearsal dinner. Full bar program, island-inspired food, tiki atmosphere.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/private-events"
          class="bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-4 hover:bg-[var(--color-sand)] transition-colors">
          Inquire About Events
        </a>
        <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer"
          class="border border-[var(--color-sand)]/30 text-[var(--color-sand)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-4 hover:border-[var(--color-amber)] hover:text-[var(--color-amber)] transition-colors">
          Reserve a Table
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
