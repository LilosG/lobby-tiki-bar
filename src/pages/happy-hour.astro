---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../data/site';
import { WEEKLY_SPECIALS, HAPPY_HOUR_DEALS } from '../data/happyHour';
---

<BaseLayout
  title="Happy Hour Oceanside | The Lobby Tiki Bar | Daily Specials Mon–Fri"
  description="Daily happy hour specials at The Lobby Tiki Bar in Oceanside CA. $6 Mai Tais on Thursdays, $6 Tacos on Tuesdays, All Day Happy Hour Mondays. 408 Pier View Way."
  image="/images/drink-dsc06150.jpg"
>
  <Nav />

  <PageHero
    label="Daily Deals"
    title="Happy Hour"
    subtitle="Daily specials Monday through Friday on Pier View Way."
    image="/images/drink-dsc06150.jpg"
    imageAlt="Happy hour cocktails at The Lobby Tiki Bar Oceanside"
    overlay="jungle"
  >
    <div class="mt-8">
      <p class="font-[family-name:var(--font-script)] text-[var(--color-amber)] text-3xl sm:text-4xl">in Oceanside</p>
    </div>
  </PageHero>

  <!-- Weekly Specials -->
  <section class="py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">Mon – Fri</p>
        <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)]">Weekly Specials</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-20">
        {WEEKLY_SPECIALS.map((item) => (
          <div class="border border-white/10 hover:border-[var(--color-amber)]/30 transition-colors p-6 text-center">
            <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-3">
              {item.short}
            </p>
            <p class="font-[family-name:var(--font-display)] text-lg text-[var(--color-sand)] leading-snug mb-1">
              {item.deal}
            </p>
            {item.note && (
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm">
                {item.note}
              </p>
            )}
          </div>
        ))}
      </div>

      <!-- Happy Hour Deals -->
      <div class="border border-[var(--color-amber)]/20 bg-[var(--color-amber)]/5 p-8 sm:p-12">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4 text-center">Happy Hour Menu</p>
        <h3 class="font-[family-name:var(--font-display)] text-3xl text-[var(--color-sand)] text-center mb-10">Drinks & Bites</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-2xl mx-auto">
          <div>
            <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-4">Drinks</p>
            <ul class="space-y-3">
              {HAPPY_HOUR_DEALS.drinks.map((item) => (
                <li class="flex justify-between items-center border-b border-white/10 pb-3">
                  <span class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-80">{item.label}</span>
                  <span class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] tracking-wider">{item.price}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-4">
              Food — {HAPPY_HOUR_DEALS.food.price} Each
            </p>
            <ul class="space-y-3">
              {HAPPY_HOUR_DEALS.food.items.map((item) => (
                <li class="flex items-center gap-3 border-b border-white/10 pb-3">
                  <span class="w-1.5 h-1.5 bg-[var(--color-amber)] rounded-full flex-shrink-0"></span>
                  <span class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-80">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tiki Taco Tuesday callout -->
  <section class="py-20 bg-[var(--color-jungle)]/30 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">Every Tuesday</p>
      <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)] mb-4">Tiki Taco Tuesday</h2>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 max-w-xl mx-auto mb-8">
        $6 Tacos and $5 Wells all evening. The weekly ritual Oceanside needed.
      </p>
      <a href="/events/tiki-taco-tuesday"
        class="inline-block border border-[var(--color-teal)] text-[var(--color-teal)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-6 py-3 hover:bg-[var(--color-teal)] hover:text-[var(--color-espresso)] transition-colors">
        Event Details
      </a>
    </div>
  </section>

  <CTASection
    title="Join Us for Happy Hour"
    subtitle="Reserve your spot or walk in. Pier View Way, Oceanside."
    primaryLabel="Reserve a Table"
    primaryHref={SITE.reservations.url}
    secondaryLabel="See Full Menu"
    secondaryHref="/menu"
  />

  <Footer />
</BaseLayout>
