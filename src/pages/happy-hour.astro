---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import TrustBar from '../components/TrustBar.astro';
import IllustrationBand from '../components/IllustrationBand.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../data/site';
import { WEEKLY_SPECIALS, HAPPY_HOUR_DEALS } from '../data/happyHour';
import { COCKTAILS } from '../data/menu';
import { HAPPY_HOUR_FAQS } from '../data/faqs';
import FAQSection from '../components/FAQSection.astro';

import drinkBarLineup   from '../assets/images/drink-bar-lineup.jpg';
import drinkDsc01014    from '../assets/images/drink-dsc01014.jpg';
import foodKaluaTacos2  from '../assets/images/food-kalua-tacos-2.jpg';
import tikiIllustration from '../assets/images/tiki-illustration-volcano.jpg';



const faqs = HAPPY_HOUR_FAQS;

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/happy-hour/#faq`,
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const hhFeatured = [
  { drink: COCKTAILS.find(c => c.name === 'Lobby Mai Tai')!,  note: 'The house standard'        },
  { drink: COCKTAILS.find(c => c.name === 'Cobra Kai')!,       note: 'If you want to commit'     },
  { drink: COCKTAILS.find(c => c.name === 'Painkiller')!,      note: 'Three levels of intensity' },
  { drink: COCKTAILS.find(c => c.name === 'Toucan Slam')!,     note: 'Dark rum float'            },
];
---

<BaseLayout
  title="Happy Hour Oceanside CA | The Lobby Tiki Bar"
  description="Best happy hour in Oceanside CA. The Lobby Tiki Bar: $6 Mai Tais Thursdays, $6 Tacos Tuesdays, All Day Happy Hour Mondays. 408 Pier View Way inside The Brick Hotel."
  image="/images/drink-dsc06150.jpg"
  heroImage={drinkBarLineup.src}
  pageSchema={faqSchema}
>
  <Nav />

  <PageHero
    label="Daily Deals"
    title="Happy Hour"
    subtitle="Something different every day. Monday through Friday on Pier View Way."
    image={drinkBarLineup}
    imageAlt="Happy hour tiki cocktails at The Lobby Tiki Bar Oceanside CA"
    overlay="gradient"
  >
    <div class="mt-6">
      <p class="font-[family-name:var(--font-script)] text-[var(--color-amber)] text-3xl sm:text-4xl">in Oceanside</p>
    </div>
  </PageHero>
  <TrustBar />

  <!-- QUICK INFO STRIP -->
  <section class="bg-[var(--color-jungle)] border-y border-white/10">
    <div class="max-w-4xl mx-auto px-6 grid grid-cols-3 divide-x divide-white/10">
      <div class="text-center py-8 px-6">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">Days</p>
        <p class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)]">{SITE.happyHour.days}</p>
      </div>
      <div class="text-center py-8 px-6">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">Hours</p>
        <p class="font-[family-name:var(--font-display)] text-base sm:text-xl text-[var(--color-sand)]">{SITE.happyHour.hours}</p>
      </div>
      <div class="text-center py-8 px-6">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">Location</p>
        <p class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)]">Pier View Way</p>
      </div>
    </div>
  </section>

  <!-- WEEKLY SPECIALS -->
  <section class="py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">Something Different Every Day</p>
        <h2 class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl text-[var(--color-sand)]">Weekly Specials</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-5 border border-white/10">
        {WEEKLY_SPECIALS.map((item) => (
          <div class="p-8 sm:p-10 text-center border-b sm:border-b-0 sm:border-r border-white/10 last:border-0 hover:bg-[var(--color-amber)]/5 transition-colors duration-300">
            <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.25em] uppercase mb-5">{item.short}</p>
            <p class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl text-[var(--color-sand)] leading-tight mb-2">{item.deal}</p>
            {item.note && (
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-sm mt-2">{item.note}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DRINKS & BITES SPLIT -->
  <section class="border-t border-white/10">
    <div class="grid lg:grid-cols-2 min-h-[600px]">
      <div class="relative overflow-hidden min-h-[400px] lg:min-h-0">
        <Image src={drinkDsc01014} alt="Lobby Mai Tai — The Lobby Tiki Bar Oceanside happy hour cocktail"
          class="w-full h-full object-cover absolute inset-0" width={900} height={900} />
        <div class="absolute inset-0 bg-gradient-to-r from-transparent to-[var(--color-espresso)]/60 lg:to-[var(--color-espresso)]/80"></div>
        <div class="absolute bottom-8 left-8">
          <p class="font-[family-name:var(--font-script)] text-[var(--color-amber)] text-4xl">Lobby Mai Tai</p>
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-sand)]/60 text-xs tracking-widest uppercase mt-1">The house standard</p>
        </div>
      </div>
      <div class="bg-[var(--color-jungle)]/20 flex items-center px-10 py-16 lg:px-16">
        <div class="w-full max-w-sm">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">Happy Hour Menu</p>
          <h2 class="font-[family-name:var(--font-display)] text-4xl text-[var(--color-sand)] mb-10">Drinks &amp; Bites</h2>
          <div class="space-y-8">
            <div>
              <p class="font-[family-name:var(--font-stamp)] text-[var(--color-sand)] opacity-50 text-xs tracking-widest uppercase mb-4">Drinks</p>
              <ul class="space-y-4">
                {HAPPY_HOUR_DEALS.drinks.map((item) => (
                  <li class="flex justify-between items-center pb-4 border-b border-white/10">
                    <span class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)]">{item.label}</span>
                    <span class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xl tracking-wider">{item.price}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="font-[family-name:var(--font-stamp)] text-[var(--color-sand)] opacity-50 text-xs tracking-widest uppercase mb-4">
                Bites &mdash; {HAPPY_HOUR_DEALS.food.price} each
              </p>
              <ul class="space-y-3">
                {HAPPY_HOUR_DEALS.food.items.map((item) => (
                  <li class="flex items-center gap-3 font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70">
                    <span class="w-1.5 h-1.5 bg-[var(--color-amber)] rounded-full flex-shrink-0"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TIKI TACO TUESDAY BAND -->
  <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <Image src={foodKaluaTacos2} alt="Tiki Taco Tuesday at The Lobby Tiki Bar Oceanside CA"
        class="w-full h-full object-cover" width={1800} height={900} />
      <div class="absolute inset-0 bg-[var(--color-espresso)]/65"></div>
    </div>
    <div class="relative z-10 text-center px-6 py-24">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">Every Tuesday</p>
      <h2 class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl text-[var(--color-sand)] leading-tight mb-2">Tiki Taco</h2>
      <p class="font-[family-name:var(--font-script)] text-[var(--color-amber)] text-5xl sm:text-6xl mb-8">Tuesday</p>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 max-w-lg mx-auto mb-10 leading-relaxed text-lg">
        $6 Tacos and $5 Wells all evening. The weekly ritual Oceanside needed.
      </p>
      <a href="/events/tiki-taco-tuesday"
        class="inline-block border border-[var(--color-teal)] text-[var(--color-teal)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-4 hover:bg-[var(--color-teal)] hover:text-[var(--color-espresso)] transition-colors">
        Event Details
      </a>
    </div>
  </section>

  <!-- WHAT TO ORDER -->
  <section class="py-24 px-6 bg-[var(--color-espresso-light)]/20">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">What to Order</p>
        <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)]">Start Here</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {hhFeatured.map(({ drink, note }) => drink && drink.image && (
          <a href="/menu#cocktails" class="group relative overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/40 transition-colors">
            <div class="aspect-square overflow-hidden">
              <Image src={drink.image} alt={`${drink.name} at The Lobby Tiki Bar Oceanside`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width={400} height={400} />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-espresso)] via-[var(--color-espresso)]/30 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <h3 class="font-[family-name:var(--font-display)] text-base sm:text-lg text-[var(--color-sand)] leading-tight">{drink.name}</h3>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-xs mt-0.5">{note}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/menu"
          class="inline-block border border-[var(--color-sand)]/30 text-[var(--color-sand)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:border-[var(--color-amber)] hover:text-[var(--color-amber)] transition-colors">
          Full Menu
        </a>
      </div>
    </div>
  </section>

  <FAQSection
    faqs={faqs}
    label="Need to Know"
    title="Happy Hour FAQ"
    background="muted"
  />
  <IllustrationBand
    image={tikiIllustration}
    imageAlt="The Lobby Tiki Bar happy hour Oceanside California"
    label="Pier View Way · Oceanside, CA"
    title="Oceanside's Best"
    scriptLine="Happy Hour"
    subtitle="The Lobby Tiki Bar runs one of the best happy hours in Oceanside CA. Every weekday we discount cocktails, beers, wine, and select bites. Monday is all-day happy hour. Thursday brings $6 Mai Tais. Walk in or reserve ahead."
    ctaLabel="Reserve a Table"
    ctaHref={SITE.reservations.url}
    ctaExternal={true}
    minHeight="50vh"
    overlayOpacity={70}
  />

  <CTASection
    title="Join Us for Happy Hour"
    subtitle="Reserve your spot or walk in. Pier View Way, Oceanside."
    primaryLabel="Reserve a Table"
    primaryHref={SITE.reservations.url}
    secondaryLabel="See Full Menu"
    secondaryHref="/menu"
  />

  <Footer />
</BaseLayout>
