---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import TrustBar from '../../components/TrustBar.astro';
import StatsBar from '../../components/StatsBar.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import IllustrationBand from '../../components/IllustrationBand.astro';
import CTASection from '../../components/CTASection.astro';
import CateringForm from '../../components/CateringForm.astro';
import FAQSection from '../../components/FAQSection.astro';
import { getCollection, getEntry } from 'astro:content';

import tikiIllustration from '../../assets/images/tiki-illustration-volcano.jpg';

export async function getStaticPaths() {
  const PRIVATE_EVENT_TYPES = (await getCollection('privateEventTypes')).map((entry) => entry.data).sort((a, b) => a.order - b.order);
  return PRIVATE_EVENT_TYPES.map((event) => ({
    params: { type: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const SITE = (await getEntry('siteSettings', 'sitesettings'))!.data;
const eventFaqs = event.faqs ?? [];
const eventDetails = event.details ?? [];
const eventIntro = event.intro ?? [];
const eventFeatures = event.features ?? [];
const eventGallery = event.gallery ?? [];
const eventStats = event.stats ?? [];
const eventWhyBody = event.whyBody ?? [];

const faqSchemaNode = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/private-events/${event.slug}/#faq`,
  mainEntity: eventFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<BaseLayout
  title={event.seoTitle}
  description={event.metaDescription}
  image="/images/venue-interior-1.jpg"
  heroImage={event.heroImage.src}
  pageSchema={faqSchemaNode}
>
  <Nav />

  <!-- HERO -->
  <section class="relative min-h-[70vh] flex items-end overflow-hidden">
    <div class="absolute inset-0">
      <Image src={event.heroImage} alt={event.heroImageAlt}
        class="w-full h-full object-cover" width={1800} height={1000} loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-espresso)] via-[var(--color-espresso)]/60 to-transparent"></div>
    </div>
    <div class="relative z-10 w-full">
      <div class="max-w-7xl mx-auto px-8 sm:px-16 pb-20">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">{event.heroLabel} &middot; The Lobby Tiki Bar</p>
        <h1 class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl lg:text-7xl text-[var(--color-sand)] leading-tight mb-8 max-w-2xl">{event.h1}</h1>
        <a href={`mailto:${SITE.email}?subject=Private Event Inquiry — ${event.h1}`}
          class="inline-block bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-4 hover:bg-[var(--color-sand)] transition-colors">
          Inquire About Your Event
        </a>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- QUICK INFO STRIP -->
  <section class="bg-[var(--color-jungle)] border-y border-white/10">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-2 sm:grid-cols-5 divide-x divide-white/10">
      {eventDetails.map((d) => (
        <div class="text-center py-7 px-4">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-1">{d.label}</p>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] text-sm leading-snug">{d.value}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- INTRO + GALLERY -->
  <section class="py-24 px-6">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-start">
      <div>
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">The Venue</p>
        <h2 class="font-[family-name:var(--font-display)] text-4xl text-[var(--color-sand)] mb-8 leading-tight">The Lobby Tiki Bar<br />in Oceanside, CA</h2>
        {eventIntro.map((para) => (
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-5">{para}</p>
        ))}
        <ul class="space-y-3 mt-8">
          {eventFeatures.map((feature) => (
            <li class="flex items-center gap-3 font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm">
              <span class="w-1.5 h-1.5 bg-[var(--color-amber)] rounded-full flex-shrink-0"></span>
              {feature}
            </li>
          ))}
        </ul>
        <a href={`mailto:${SITE.email}?subject=Private Event Inquiry — ${event.h1}`}
          class="inline-block mt-10 border border-[var(--color-amber)] text-[var(--color-amber)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-amber)] hover:text-[var(--color-espresso)] transition-colors">
          Start Planning
        </a>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {eventGallery.map((item, i) => (
          <div class:list={["overflow-hidden", i === 0 ? "col-span-2 aspect-video" : "aspect-square"]}>
            <Image src={item.img} alt={item.alt}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              width={i === 0 ? 900 : 450} height={i === 0 ? 506 : 450} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <StatsBar stats={eventStats} background="espresso" />

  <!-- WHY SECTION -->
  <section class="py-24 px-6 bg-[var(--color-jungle)]/20">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <SectionHeader label="Private Events" title={event.whyTitle} align="left" />
        {eventWhyBody.map((para) => (
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-5">{para}</p>
        ))}
        <a href={`mailto:${SITE.email}?subject=Private Event Inquiry — ${event.h1}`}
          class="inline-block mt-4 bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-sand)] transition-colors">
          Inquire Now
        </a>
      </div>
      <div class="space-y-4">
        <div class="border border-white/10 p-8">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-4">What's Included</p>
          <ul class="space-y-3">
            {eventFeatures.map((feature) => (
              <li class="flex items-center gap-3 font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm pb-3 border-b border-white/10 last:border-b-0">
                <span class="w-1.5 h-1.5 bg-[var(--color-amber)] rounded-full flex-shrink-0"></span>
                {feature}
              </li>
            ))}
          </ul>
        </div>
        <div class="border border-white/10 p-8">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-3">Get Started</p>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 text-sm leading-relaxed mb-4">
            Email us with your date, group size, and occasion. We'll put together a custom package and get back to you quickly.
          </p>
          <a href={`mailto:${SITE.email}?subject=Private Event Inquiry — ${event.h1}`}
            class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase hover:text-[var(--color-sand)] transition-colors">
            {SITE.email} &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <IllustrationBand
    image={tikiIllustration}
    imageAlt={`${event.h1} at The Lobby Tiki Bar Oceanside California`}
    label="408 Pier View Way &middot; Oceanside, CA"
    title={event.illustrationTitle}
    scriptLine={event.illustrationScriptLine}
    subtitle={event.illustrationSubtitle}
    ctaLabel="Inquire About Your Event"
    ctaHref={`mailto:${SITE.email}?subject=Private Event Inquiry — ${event.h1}`}
    minHeight="50vh"
    overlayOpacity={72}
  />

  <FAQSection
    faqs={eventFaqs}
    label="Common Questions"
    title="Frequently Asked Questions"
    background="muted"
  />

  <CateringForm title={`Book Your ${event.h1.replace("in Oceanside", "").trim()}`} subtitle="Tell us your date, group size, and occasion. We'll put together a package that works." />

  <CTASection
    title="Explore the Full Venue"
    subtitle="See the space, the bar program, and everything The Lobby has to offer."
    primaryLabel="Explore the Venue"
    primaryHref="/the-lobby"
    secondaryLabel="All Private Events"
    secondaryHref="/private-events"
  />

  <Footer />
</BaseLayout>
