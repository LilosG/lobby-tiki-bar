---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import CateringForm from '../../components/CateringForm.astro';
import FAQSection from '../../components/FAQSection.astro';
import { SITE } from '../../data/site';
import { PRIVATE_EVENT_TYPES } from '../../data/privateEvents';

export function getStaticPaths() {
  return PRIVATE_EVENT_TYPES.map((event) => ({
    params: { type: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;

const faqSchemaNode = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/private-events/${event.slug}/#faq`,
  mainEntity: event.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<BaseLayout
  title={event.seoTitle}
  description={event.metaDescription}
  image="/images/venue-interior-1.jpg"
  heroImage={event.heroImage.src}
  pageSchema={faqSchemaNode}
>
  <Nav />

  <!-- HERO -->
  <section class="relative min-h-[70vh] flex items-end overflow-hidden">
    <div class="absolute inset-0">
      <Image src={event.heroImage} alt={event.heroImageAlt}
        class="w-full h-full object-cover" width={1800} height={1000} loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-espresso)] via-[var(--color-espresso)]/60 to-transparent"></div>
    </div>
    <div class="relative z-10 w-full">
      <div class="max-w-7xl mx-auto px-8 sm:px-16 pb-20">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">{event.heroLabel} · The Lobby Tiki Bar</p>
        <h1 class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl lg:text-7xl text-[var(--color-sand)] leading-tight mb-8 max-w-2xl">{event.h1}</h1>
        <a href={`mailto:${SITE.email}?subject=Private Event Inquiry — ${event.h1}`}
          class="inline-block bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-4 hover:bg-[var(--color-sand)] transition-colors">
          Inquire About Your Event
        </a>
      </div>
    </div>
  </section>

  <!-- QUICK INFO STRIP -->
  <section class="bg-[var(--color-jungle)] border-y border-white/10">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-2 sm:grid-cols-5 divide-x divide-white/10">
      {event.details.map((d) => (
        <div class="text-center py-7 px-4">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-1">{d.label}</p>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] text-sm leading-snug">{d.value}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- INTRO + GALLERY -->
  <section class="py-24 px-6">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-start">
      <div>
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">The Venue</p>
        <h2 class="font-[family-name:var(--font-display)] text-4xl text-[var(--color-sand)] mb-8 leading-tight">The Lobby Tiki Bar<br />in Oceanside, CA</h2>
        {event.intro.map((para) => (
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-5">{para}</p>
        ))}
        <a href={`mailto:${SITE.email}?subject=Private Event Inquiry — ${event.h1}`}
          class="inline-block mt-4 border border-[var(--color-amber)] text-[var(--color-amber)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-amber)] hover:text-[var(--color-espresso)] transition-colors">
          Start Planning
        </a>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {event.gallery.map((item, i) => (
          <div class:list={["overflow-hidden", i === 0 ? "col-span-2 aspect-video" : "aspect-square"]}>
            <Image src={item.img} alt={item.alt}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              width={i === 0 ? 900 : 450} height={i === 0 ? 506 : 450} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQSection
    faqs={event.faqs}
    label="Common Questions"
    title="Frequently Asked Questions"
    background="muted"
  />

  <CateringForm title={`Book Your ${event.h1.replace("in Oceanside", "").trim()}`} subtitle="Tell us your date, group size, and occasion. We'll put together a package that works." />

  <CTASection
    title="Explore the Full Venue"
    subtitle="See the space, the bar program, and everything The Lobby has to offer."
    primaryLabel="Explore the Venue"
    primaryHref="/the-lobby"
    secondaryLabel="All Private Events"
    secondaryHref="/private-events"
  />

  <Footer />
</BaseLayout>
