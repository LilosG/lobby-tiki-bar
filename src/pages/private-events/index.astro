---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import TrustBar from '../../components/TrustBar.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { getOrderedCollection, getSingleton } from '../../lib/content';
import FAQSection from '../../components/FAQSection.astro';
import CateringForm from '../../components/CateringForm.astro';

import venueInterior2      from '../../assets/images/venue-interior-2.jpg';

const SITE = await getSingleton('siteSettings');
const copy = await getSingleton('privateEventsIndexPage');
const PRIVATE_EVENT_TYPES = await getOrderedCollection('privateEventTypes');
const stats = copy.stats;
const faqs = await getOrderedCollection('faqsPrivateEvents');

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/private-events/#faq`,
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title={copy.seo.title}
  description={copy.seo.description}
  image={copy.seo.image}
  heroImage={venueInterior2.src}
  pageSchema={faqSchema}
>
  <Nav />

  <PageHero
    label={copy.hero.label}
    title={copy.hero.title}
    subtitle={copy.hero.subtitle}
    image={venueInterior2}
    imageAlt={copy.hero.imageAlt}
    overlay="dark"
  />

  <section class="py-24 px-6">
  <TrustBar />
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">{copy.eventTypes.label}</p>
        <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)]">{copy.eventTypes.title}</h2>
      </div>
      {(() => {
        const cardImages = copy.eventTypes.cardImages;
        return (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {PRIVATE_EVENT_TYPES.map((event, i) => (
              <a href={`/private-events/${event.slug}`}
                class="group relative overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/30 transition-colors block">
                <div class="aspect-video overflow-hidden">
                  <Image src={cardImages[i]} alt={event.heroImageAlt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80"
                    width={800} height={450} />
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-espresso)] via-[var(--color-espresso)]/50 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8">
                  <h3 class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-sand)] mb-2">{event.h1}</h3>
                  <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm leading-relaxed mb-4">{event.summary}</p>
                  <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase group-hover:underline" set:html={copy.eventTypes.cta} />
                </div>
              </a>
            ))}
          </div>
        );
      })()}
    </div>
  </section>

  <section class="py-16 px-6 bg-[var(--color-jungle)]/30">
    <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-px bg-white/10">
      {stats.map((item: any) => (
        <div class="bg-[var(--color-espresso)] py-10 px-6 text-center">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">{item.label}</p>
          <p class="font-[family-name:var(--font-display)] text-3xl text-[var(--color-sand)] mb-1">{item.value}</p>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-sm">{item.note}</p>
        </div>
      ))}
    </div>
  </section>

  <FAQSection
    faqs={faqs}
    label={copy.faq.label}
    title={copy.faq.title}
    background="muted"
  />

  <CateringForm title={copy.form.title} subtitle={copy.form.subtitle} />

  <Footer />
</BaseLayout>
