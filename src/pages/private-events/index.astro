---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import TrustBar from '../../components/TrustBar.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, getEntry } from 'astro:content';
import FAQSection from '../../components/FAQSection.astro';
import CateringForm from '../../components/CateringForm.astro';

import venueInterior2      from '../../assets/images/venue-interior-2.jpg';
import venueBoothLandscape from '../../assets/images/venue-booth-landscape.jpg';
import venueCurtainEdit    from '../../assets/images/venue-curtain-edit.jpg';
import venueRoomPortrait   from '../../assets/images/venue-room-portrait.jpg';
import venueBoothPortrait  from '../../assets/images/venue-booth-portrait.jpg';

const SITE = (await getEntry('siteSettings', 'sitesettings'))!.data;
const content = (await getEntry('privateEventsIndexPage', 'privateeventsindexpage'))!.data;
const stats = content.stats ?? [];
const PRIVATE_EVENT_TYPES = (await getCollection('privateEventTypes')).map((entry) => entry.data).sort((a, b) => a.order - b.order);
const faqs = (await getCollection('privateEventsFaqs')).sort((a, b) => a.id.localeCompare(b.id)).map((entry) => entry.data);

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/private-events/#faq`,
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  image={content.seo.image}
  heroImage={venueInterior2.src}
  pageSchema={faqSchema}
>
  <Nav />

  <PageHero
    label={content.hero.label}
    title={content.hero.title}
    subtitle={content.hero.subtitle}
    image={venueInterior2}
    imageAlt={content.hero.imageAlt}
    overlay="dark"
  />

  <section class="py-24 px-6">
  <TrustBar />
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">{content.events.label}</p>
        <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)]">{content.events.title}</h2>
      </div>
      {(() => {
        const cardImages = [venueBoothLandscape, venueCurtainEdit, venueRoomPortrait, venueBoothPortrait];
        return (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {PRIVATE_EVENT_TYPES.map((event, i) => (
              <a href={`/private-events/${event.slug}`}
                class="group relative overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/30 transition-colors block">
                <div class="aspect-video overflow-hidden">
                  <Image src={cardImages[i]} alt={event.heroImageAlt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80"
                    width={800} height={450} />
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-espresso)] via-[var(--color-espresso)]/50 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8">
                  <h3 class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-sand)] mb-2">{event.h1}</h3>
                  <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm leading-relaxed mb-4">{event.summary}</p>
                  <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase group-hover:underline">Learn More &rarr;</p>
                </div>
              </a>
            ))}
          </div>
        );
      })()}
    </div>
  </section>

  {stats.length > 0 && <section class="py-16 px-6 bg-[var(--color-jungle)]/30">
    <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-px bg-white/10">
      {stats.map((item: { label: string; value: string; note: string }) => (
        <div class="bg-[var(--color-espresso)] py-10 px-6 text-center">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">{item.label}</p>
          <p class="font-[family-name:var(--font-display)] text-3xl text-[var(--color-sand)] mb-1">{item.value}</p>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-sm">{item.note}</p>
        </div>
      ))}
    </div>
  </section>}

  <FAQSection
    faqs={faqs}
    label={content.faq.label}
    title={content.faq.title}
    background="muted"
  />

  <CateringForm title={content.form.title} subtitle={content.form.subtitle} />

  <Footer />
</BaseLayout>
