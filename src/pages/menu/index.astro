---
import { Image } from 'astro:assets';
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import CTASection from "../../components/CTASection.astro";
import { SITE } from "../../data/site";
import { COCKTAILS, NON_ALCOHOLIC, DRAFT_BEER, CANS_BOTTLES, WINE, FOOD } from "../../data/menu";

import drinkCollection from '../../assets/images/drink-collection.jpg';
import drinkDsc06150Page from '../../assets/images/drink-dsc06150.jpg';
import foodKaluaTacos2 from '../../assets/images/food-kalua-tacos-2.jpg';
import drinkLobbyGlass2 from '../../assets/images/drink-lobby-glass-2.jpg';
import drinkCopperPineapple from '../../assets/images/drink-copper-pineapple.jpg';
import drinkBarLifestyle from '../../assets/images/drink-bar-lifestyle.jpg';


const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/menu/#faq`,
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What kind of cocktails does The Lobby Tiki Bar serve?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The Lobby Tiki Bar serves 20+ craft tiki cocktails including the Lobby Mai Tai, Cobra Kai, Temple of Doom, Painkiller, and Toucan Slam. All cocktails use house rum blends, fresh juice, and house-made syrups.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does The Lobby Tiki Bar serve food?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The Lobby Tiki Bar serves island-inspired food including Crab Rangoon, Coconut Shrimp, Poke Inari Bombs, Kalua Tacos, Huli Huli Chicken, Loco Moco, and the Tropicana Burger.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does The Lobby Tiki Bar have a brunch menu?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Weekend brunch at The Lobby Tiki Bar is Saturday and Sunday from 10:00 AM to 3:00 PM. Island-inspired brunch plates are served alongside the full cocktail program.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does The Lobby Tiki Bar have non-alcoholic drinks?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Non-alcoholic tiki cocktails include the No Tai, Painless Killer, and NoJito — crafted with the same ingredients as the full bar program, minus the rum.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I see a menu before visiting The Lobby Tiki Bar?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The full menu is available at lobbytikibar.com/menu including tiki cocktails, island food, beer, wine, and non-alcoholic options.',
      },
    },
  ],
};

const featuredCocktails  = COCKTAILS.filter((c) => c.featured && c.image !== null);
const remainingCocktails = COCKTAILS.filter((c) => !c.featured || c.image === null);

---

<BaseLayout
  title="Tiki Cocktails & Island Food Menu | The Lobby Oceanside"
  description="Full menu at The Lobby Tiki Bar in Oceanside CA. Tiki cocktails, island-inspired food, beer and wine. 408 Pier View Way inside The Brick Hotel."
  image="/images/drink-cobra-kai.jpg"
  heroImage={drinkCollection.src}
  pageSchema={faqSchema}
>
  <Nav />

  <!-- HERO -->
  <section class="relative min-h-[85vh] flex items-end overflow-hidden">
    <div class="absolute inset-0">
      <Image src={drinkCollection} alt="Tiki cocktails at The Lobby Tiki Bar Oceanside CA"
        class="w-full h-full object-cover" width={1800} height={1000} loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-espresso)]/90 via-[var(--color-espresso)]/40 to-transparent"></div>
    </div>
    <div class="relative z-10 w-full px-16 sm:px-24 pb-32"><div class="max-w-xl">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">408 Pier View Way · Oceanside</p>
      <h1 class="font-[family-name:var(--font-display)] text-7xl sm:text-8xl text-[var(--color-sand)] leading-none mb-4">The Menu</h1>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 max-w-md leading-relaxed mb-8">Craft tiki cocktails, island-inspired plates, and all the happy hour specials.</p>
      <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer"
        class="inline-block bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-sand)] transition-colors">
        Reserve a Table
      </a>
    </div></div>
  </section>

  <!-- STICKY NAV -->
  <div class="sticky top-16 z-30 bg-[var(--color-espresso)] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 flex gap-8 overflow-x-auto py-4">
      {[["cocktails","Cocktails"],["food","Food"],["beer-wine","Beer & Wine"],["non-alcoholic","Non-Alcoholic"]].map(([id, label]) => (
        <a href={`#${id}`}
          class="font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase text-[var(--color-sand)] opacity-60 hover:opacity-100 hover:text-[var(--color-amber)] transition-all whitespace-nowrap">
          {label}
        </a>
      ))}
    </div>
  </div>

  <!-- EXPLORE THE BAR -->
  <section class="max-w-7xl mx-auto px-6 pt-20 pb-0">
    <div class="mb-10">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-3">The Lobby Tiki Bar</p>
      <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)]">Explore the Bar</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a href="#cocktails" class="group block overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/40 transition-colors duration-300">
        <div class="aspect-square overflow-hidden">
          <Image src={drinkDsc06150Page} alt="Tiki cocktails at The Lobby Tiki Bar Oceanside CA"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
            width={700} height={467} />
        </div>
        <div class="p-6">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.25em] uppercase mb-2">The Bar Program</p>
          <h3 class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-sand)] mb-2">Tiki Cocktails</h3>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm leading-relaxed">20+ craft tiki cocktails. House rum blends, fresh juice, house-made syrups.</p>
        </div>
      </a>
      <a href="/happy-hour" class="group block overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/40 transition-colors duration-300">
        <div class="aspect-square overflow-hidden">
          <Image src={drinkLobbyGlass2} alt="Happy hour at The Lobby Tiki Bar Oceanside CA"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
            width={700} height={467} />
        </div>
        <div class="p-6">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.25em] uppercase mb-2">Tue &ndash; Fri</p>
          <h3 class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-sand)] mb-2">Happy Hour</h3>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm leading-relaxed">3 PM &ndash; 5 PM. Discounted cocktails, wells, and bites every weekday.</p>
        </div>
      </a>
      <a href="/brunch" class="group block overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/40 transition-colors duration-300">
        <div class="aspect-square overflow-hidden">
          <Image src={drinkCopperPineapple} alt="Weekend brunch cocktails at The Lobby Tiki Bar Oceanside CA"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
            width={700} height={467} />
        </div>
        <div class="p-6">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.25em] uppercase mb-2">Saturday &amp; Sunday</p>
          <h3 class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-sand)] mb-2">Weekend Brunch</h3>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm leading-relaxed">10 AM &ndash; 3 PM. Island plates, morning cocktails, and the full bar program.</p>
        </div>
      </a>
    </div>
  </section>

  <!-- COCKTAIL LINEUP — full-bleed -->
  <section class="relative w-full overflow-hidden">
    <div class="aspect-[21/7]">
      <Image src={drinkBarLifestyle} alt="The Lobby Tiki Bar craft cocktail program Oceanside CA"
        class="w-full h-full object-cover object-center" width={1800} height={686} />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-espresso)]/80 via-[var(--color-espresso)]/20 to-transparent"></div>
    <div class="absolute inset-0 flex items-center px-16 sm:px-24">
      <div>
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-3">The Bar Program</p>
        <p class="font-[family-name:var(--font-display)] text-3xl sm:text-6xl text-[var(--color-sand)] leading-tight">
          20+ Tiki<br />Cocktails
        </p>
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 text-sm max-w-xs leading-relaxed mt-4 hidden sm:block">
          House rum blends, fresh juice,<br />house-made syrups.
        </p>
      </div>
    </div>
  </section>

  <!-- COCKTAILS GRID + FOOD -->
  <div class="max-w-7xl mx-auto px-6 pt-16 pb-20 space-y-28">
    <section id="cocktails">
      <h2 class="font-[family-name:var(--font-display)] text-5xl text-[var(--color-sand)] mb-2">Tiki Cocktails</h2>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-sm mb-10">An ID may be required with specialty vessels.</p>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-8">
        {featuredCocktails.map((drink) => (
          <div class="group relative overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/40 transition-colors duration-300">
            <div class="aspect-[3/4] overflow-hidden">
              <Image src={drink.image!} alt={`${drink.name} tiki cocktail at The Lobby Tiki Bar Oceanside`}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
                width={500} height={667} />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-espresso)] via-[var(--color-espresso)]/50 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
              <h3 class="font-[family-name:var(--font-display)] text-lg sm:text-xl text-[var(--color-sand)] mb-1 leading-tight">{drink.name}</h3>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 text-xs leading-relaxed hidden sm:block">{drink.description}</p>
              {drink.note && (
                <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] opacity-70 text-xs mt-2 tracking-wide">{drink.note}</p>
              )}
            </div>
          </div>
        ))}
      </div>

      <div>
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-6">Also on the Menu</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {remainingCocktails.map((drink) => (
            <div class="p-6 border border-white/10 hover:border-[var(--color-amber)]/30 transition-colors">
              <h3 class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)] mb-2">{drink.name}</h3>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm leading-relaxed">{drink.description}</p>
              {drink.note && (
                <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] opacity-60 text-xs mt-2 tracking-wide">{drink.note}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FOOD -->
    <section id="food">
      <h2 class="font-[family-name:var(--font-display)] text-5xl text-[var(--color-sand)] mb-4">Island Kitchen</h2>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-sm mb-12">Island-inspired plates built to complement the rum program.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        {FOOD.map((item) => (
          <div class="group overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/30 transition-colors">
            <div class="aspect-square overflow-hidden">
              <Image src={item.image} alt={`${item.name} at The Lobby Tiki Bar Oceanside CA`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width={400} height={400} />
            </div>
            <div class="p-5">
              <h3 class="font-[family-name:var(--font-display)] text-lg text-[var(--color-sand)] mb-1">{item.name}</h3>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-xs leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center">
        <a href="/brunch"
          class="inline-block border border-[var(--color-teal)] text-[var(--color-teal)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-teal)] hover:text-[var(--color-espresso)] transition-colors">
          Weekend Brunch Menu →
        </a>
      </div>
    </section>

  </div>

  <!-- TIKI TACO TUESDAY — full-bleed editorial banner -->
  <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <Image src={foodKaluaTacos2} alt="Tiki Taco Tuesday at The Lobby Tiki Bar Oceanside CA"
        class="w-full h-full object-cover" width={1800} height={900} />
      <div class="absolute inset-0 bg-[var(--color-espresso)]/65"></div>
    </div>
    <div class="relative z-10 text-center px-6 py-24">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">Every Tuesday</p>
      <h2 class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl text-[var(--color-sand)] leading-tight mb-4">
        Tiki Taco<br />Tuesday
      </h2>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-base mb-8">$6 Tacos · $5 Wells · All Day</p>
      <a href="/happy-hour"
        class="inline-block border border-[var(--color-amber)] text-[var(--color-amber)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-amber)] hover:text-[var(--color-espresso)] transition-colors">
        View Happy Hour Specials
      </a>
    </div>
  </section>

  <!-- BEER & WINE + NON-ALCOHOLIC -->
  <div class="max-w-7xl mx-auto px-6 pt-20 pb-20 space-y-28">

    <section id="beer-wine">
      <h2 class="font-[family-name:var(--font-display)] text-5xl text-[var(--color-sand)] mb-12">Beer &amp; Wine</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="border border-white/10 p-8">
          <h3 class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-6">Draft Beer</h3>
          <ul class="space-y-3">
            {DRAFT_BEER.map((b) => (
              <li class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm pb-3 border-b border-white/10 last:border-b-0">{b}</li>
            ))}
          </ul>
        </div>
        <div class="border border-white/10 p-8">
          <h3 class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-6">Cans &amp; Bottles</h3>
          <ul class="space-y-3">
            {CANS_BOTTLES.map((b) => (
              <li class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm pb-3 border-b border-white/10 last:border-b-0">{b.name}</li>
            ))}
          </ul>
        </div>
        <div class="border border-white/10 p-8">
          <h3 class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-6">Wine</h3>
          <ul class="space-y-3">
            {WINE.map((w) => (
              <li class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm pb-3 border-b border-white/10 last:border-b-0">{w.name}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="non-alcoholic">
      <h2 class="font-[family-name:var(--font-display)] text-5xl text-[var(--color-sand)] mb-4">Non-Alcoholic</h2>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-sm mb-12">All the flavor. None of the rum.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {NON_ALCOHOLIC.map((d) => (
          <div class="p-6 border border-white/10 hover:border-[var(--color-amber)]/30 transition-colors">
            <h3 class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)] mb-2">{d.name}</h3>
            <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm leading-relaxed">{d.description}</p>
          </div>
        ))}
      </div>
    </section>

  </div>

  <CTASection
    title="Ready to Order?"
    subtitle="Reserve your table or come on in."
    primaryLabel="Reserve a Table"
    primaryHref={SITE.reservations.url}
    secondaryLabel="Book Private Event"
    secondaryHref="/private-events"
  />
  <Footer />
</BaseLayout>
