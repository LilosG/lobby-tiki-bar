---
import { Image } from 'astro:assets';
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import CTASection from "../../components/CTASection.astro";
import { getOrderedCollection, getSingleton, rawBlock } from '../../lib/content';

import drinkCollection from '../../assets/images/drink-collection.jpg';
import drinkDsc06150Page from '../../assets/images/drink-dsc06150.jpg';
import foodKaluaTacos2 from '../../assets/images/food-kalua-tacos-2.jpg';
import drinkLobbyGlass2 from '../../assets/images/drink-lobby-glass-2.jpg';
import drinkCopperPineapple from '../../assets/images/drink-copper-pineapple.jpg';
import drinkBarLifestyle from '../../assets/images/drink-bar-lifestyle.jpg';
import FAQSection from '../../components/FAQSection.astro';



const SITE = await getSingleton('siteSettings');
const copy = await getSingleton('menuPage');
const COCKTAILS = await getOrderedCollection('cocktails');
const NON_ALCOHOLIC = await getOrderedCollection('nonAlcoholicDrinks');
const DRAFT_BEER = await getOrderedCollection('draftBeers');
const CANS_BOTTLES = await getOrderedCollection('cansBottles');
const WINE = await getOrderedCollection('wines');
const FOOD = [
  ...await getOrderedCollection('foodStarters'),
  ...await getOrderedCollection('foodTacos'),
  ...await getOrderedCollection('foodEntrees'),
];
const faqs = await getOrderedCollection('faqsMenu');

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/menu/#faq`,
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const featuredCocktails  = COCKTAILS.filter((c: any) => c.featured && c.image !== null);
const remainingCocktails = COCKTAILS.filter((c: any) => !c.featured || c.image === null);

---

<BaseLayout
  title={copy.seo.title}
  description={copy.seo.description}
  image={copy.seo.image}
  heroImage={drinkCollection.src}
  pageSchema={faqSchema}
>
  <Nav />

  <!-- HERO -->
  <section class="relative min-h-[85vh] flex items-end overflow-hidden">
    <div class="absolute inset-0">
      <Image src={drinkCollection} alt="Tiki cocktails at The Lobby Tiki Bar Oceanside CA"
        class="w-full h-full object-cover" width={1800} height={1000} loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-espresso)]/90 via-[var(--color-espresso)]/40 to-transparent"></div>
    </div>
    <div class="relative z-10 w-full px-16 sm:px-24 pb-32"><div class="max-w-xl">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">{copy.hero.label}</p>
      <h1 class="font-[family-name:var(--font-display)] text-7xl sm:text-8xl text-[var(--color-sand)] leading-none mb-4">{copy.hero.title}</h1>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 max-w-md leading-relaxed mb-8">{copy.hero.body}</p>
      <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer"
        class="inline-block bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-sand)] transition-colors" set:html={rawBlock(copy.hero.cta)} />
    </div></div>
  </section>

  <!-- STICKY NAV -->
  <div class="sticky top-16 z-30 bg-[var(--color-espresso)] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 flex gap-8 overflow-x-auto py-4">
      {copy.nav.map((item: any) => (
        <a href={`#${item.id}`}
          class="font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase text-[var(--color-sand)] opacity-60 hover:opacity-100 hover:text-[var(--color-amber)] transition-all whitespace-nowrap">
          {item.label}
        </a>
      ))}
    </div>
  </div>

  <!-- EXPLORE THE BAR -->
  <section class="max-w-7xl mx-auto px-6 pt-20 pb-0">
    <div class="mb-10">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-3">{copy.explore.label}</p>
      <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)]">{copy.explore.title}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a href="#cocktails" class="group block overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/40 transition-colors duration-300">
        <div class="aspect-square overflow-hidden">
          <Image src={drinkDsc06150Page} alt="Tiki cocktails at The Lobby Tiki Bar Oceanside CA"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
            width={700} height={467} />
        </div>
        <div class="p-6">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.25em] uppercase mb-2">{copy.explore.cards[0].label}</p>
          <h3 class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-sand)] mb-2">{copy.explore.cards[0].title}</h3>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm leading-relaxed">{copy.explore.cards[0].body}</p>
        </div>
      </a>
      <a href="/happy-hour" class="group block overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/40 transition-colors duration-300">
        <div class="aspect-square overflow-hidden">
          <Image src={drinkLobbyGlass2} alt="Happy hour at The Lobby Tiki Bar Oceanside CA"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
            width={700} height={467} />
        </div>
        <div class="p-6">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.25em] uppercase mb-2" set:html={copy.explore.cards[1].label} />
          <h3 class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-sand)] mb-2">{copy.explore.cards[1].title}</h3>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm leading-relaxed" set:html={copy.explore.cards[1].body} />
        </div>
      </a>
      <a href="/brunch" class="group block overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/40 transition-colors duration-300">
        <div class="aspect-square overflow-hidden">
          <Image src={drinkCopperPineapple} alt="Weekend brunch cocktails at The Lobby Tiki Bar Oceanside CA"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
            width={700} height={467} />
        </div>
        <div class="p-6">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.25em] uppercase mb-2">{copy.explore.cards[2].label}</p>
          <h3 class="font-[family-name:var(--font-display)] text-2xl text-[var(--color-sand)] mb-2">{copy.explore.cards[2].title}</h3>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm leading-relaxed" set:html={copy.explore.cards[2].body} />
        </div>
      </a>
    </div>
  </section>

  <!-- COCKTAIL LINEUP — full-bleed -->
  <section class="relative w-full overflow-hidden">
    <div class="aspect-[21/7]">
      <Image src={drinkBarLifestyle} alt="The Lobby Tiki Bar craft cocktail program Oceanside CA"
        class="w-full h-full object-cover object-center" width={1800} height={686} />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-espresso)]/80 via-[var(--color-espresso)]/20 to-transparent"></div>
    <div class="absolute inset-0 flex items-center px-16 sm:px-24">
      <div>
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-3">{copy.lineup.label}</p>
        <p
          class="font-[family-name:var(--font-display)] text-3xl sm:text-6xl text-[var(--color-sand)] leading-tight"
          set:html={rawBlock(`${copy.lineup.title}<br>${copy.lineup.titleLine2}`)}
        />
        <p
          class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 text-sm max-w-xs leading-relaxed mt-4 hidden sm:block"
          set:html={rawBlock(`${copy.lineup.body[0]}<br>${copy.lineup.body[1]}`)}
        />
      </div>
    </div>
  </section>

  <!-- COCKTAILS GRID + FOOD -->
  <div class="max-w-7xl mx-auto px-6 pt-16 pb-20 space-y-28">
    <section id="cocktails">
      <h2 class="font-[family-name:var(--font-display)] text-5xl text-[var(--color-sand)] mb-2">{copy.cocktails.title}</h2>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-sm mb-10">{copy.cocktails.note}</p>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-8">
        {featuredCocktails.map((drink) => (
          <div class="group relative overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/40 transition-colors duration-300">
            <div class="aspect-[3/4] overflow-hidden">
              <Image src={drink.image!} alt={`${drink.name} tiki cocktail at The Lobby Tiki Bar Oceanside`}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
                width={500} height={667} />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-espresso)] via-[var(--color-espresso)]/50 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
              <h3 class="font-[family-name:var(--font-display)] text-lg sm:text-xl text-[var(--color-sand)] mb-1 leading-tight">{drink.name}</h3>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 text-xs leading-relaxed hidden sm:block">{drink.description}</p>
              {drink.note && (
                <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] opacity-70 text-xs mt-2 tracking-wide">{drink.note}</p>
              )}
            </div>
          </div>
        ))}
      </div>

      <div>
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-6">{copy.cocktails.remainingLabel}</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {remainingCocktails.map((drink) => (
            <div class="p-6 border border-white/10 hover:border-[var(--color-amber)]/30 transition-colors">
              <h3 class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)] mb-2">{drink.name}</h3>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm leading-relaxed">{drink.description}</p>
              {drink.note && (
                <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] opacity-60 text-xs mt-2 tracking-wide">{drink.note}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FOOD -->
    <section id="food">
      <h2 class="font-[family-name:var(--font-display)] text-5xl text-[var(--color-sand)] mb-4">{copy.food.title}</h2>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-sm mb-12">{copy.food.body}</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        {FOOD.map((item) => (
          <div class="group overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/30 transition-colors">
            <div class="aspect-square overflow-hidden">
              <Image src={item.image} alt={`${item.name} at The Lobby Tiki Bar Oceanside CA`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width={400} height={400} />
            </div>
            <div class="p-5">
              <h3 class="font-[family-name:var(--font-display)] text-lg text-[var(--color-sand)] mb-1">{item.name}</h3>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-xs leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center">
        <a href="/brunch"
          class="inline-block border border-[var(--color-teal)] text-[var(--color-teal)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-teal)] hover:text-[var(--color-espresso)] transition-colors" set:html={rawBlock(copy.food.cta)} />
      </div>
    </section>

  </div>

  <!-- TIKI TACO TUESDAY — full-bleed editorial banner -->
  <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <Image src={foodKaluaTacos2} alt="Tiki Taco Tuesday at The Lobby Tiki Bar Oceanside CA"
        class="w-full h-full object-cover" width={1800} height={900} />
      <div class="absolute inset-0 bg-[var(--color-espresso)]/65"></div>
    </div>
    <div class="relative z-10 text-center px-6 py-24">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">{copy.tacoTuesday.label}</p>
      <h2
        class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl text-[var(--color-sand)] leading-tight mb-4"
        set:html={rawBlock(`${copy.tacoTuesday.title}<br>${copy.tacoTuesday.titleLine2}`)}
      />
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-base mb-8">{copy.tacoTuesday.body}</p>
      <a href="/happy-hour"
        class="inline-block border border-[var(--color-amber)] text-[var(--color-amber)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-amber)] hover:text-[var(--color-espresso)] transition-colors" set:html={rawBlock(copy.tacoTuesday.cta)} />
    </div>
  </section>

  <!-- BEER & WINE + NON-ALCOHOLIC -->
  <div class="max-w-7xl mx-auto px-6 pt-20 pb-20 space-y-28">

    <section id="beer-wine">
      <h2 class="font-[family-name:var(--font-display)] text-5xl text-[var(--color-sand)] mb-12">{copy.beerWine.title}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="border border-white/10 p-8">
          <h3 class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-6">{copy.beerWine.draftLabel}</h3>
          <ul class="space-y-3">
            {DRAFT_BEER.map((b: any) => (
              <li class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm pb-3 border-b border-white/10 last:border-b-0">{b.name}</li>
            ))}
          </ul>
        </div>
        <div class="border border-white/10 p-8">
          <h3 class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-6">{copy.beerWine.cansLabel}</h3>
          <ul class="space-y-3">
            {CANS_BOTTLES.map((b) => (
              <li class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm pb-3 border-b border-white/10 last:border-b-0">{b.name}</li>
            ))}
          </ul>
        </div>
        <div class="border border-white/10 p-8">
          <h3 class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-6">{copy.beerWine.wineLabel}</h3>
          <ul class="space-y-3">
            {WINE.map((w) => (
              <li class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm pb-3 border-b border-white/10 last:border-b-0">{w.name}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="non-alcoholic">
      <h2 class="font-[family-name:var(--font-display)] text-5xl text-[var(--color-sand)] mb-4">{copy.nonAlcoholic.title}</h2>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-sm mb-12">{copy.nonAlcoholic.body}</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {NON_ALCOHOLIC.map((d) => (
          <div class="p-6 border border-white/10 hover:border-[var(--color-amber)]/30 transition-colors">
            <h3 class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)] mb-2">{d.name}</h3>
            <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm leading-relaxed">{d.description}</p>
          </div>
        ))}
      </div>
    </section>

  </div>

  <FAQSection
    faqs={faqs}
    label={copy.faq.label}
    title={copy.faq.title}
    background="muted"
  />
  <CTASection
    title={copy.cta.title}
    subtitle={copy.cta.subtitle}
    primaryLabel={copy.cta.primaryLabel}
    primaryHref={SITE.reservations.url}
    secondaryLabel={copy.cta.secondaryLabel}
    secondaryHref="/private-events"
  />
  <Footer />
</BaseLayout>
