---
import { Image } from 'astro:assets';
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import TrustBar from "../components/TrustBar.astro";
import StatsBar from "../components/StatsBar.astro";
import SectionHeader from "../components/SectionHeader.astro";
import IllustrationBand from "../components/IllustrationBand.astro";
import CTASection from "../components/CTASection.astro";
import { getOrderedCollection, getSingleton, rawBlock } from '../lib/content';
import FAQSection from '../components/FAQSection.astro';

import venueInterior1    from '../assets/images/venue-interior-1.jpg';
import venueRoomPortrait from '../assets/images/venue-room-portrait.jpg';
import tikiIllustration  from '../assets/images/tiki-illustration-volcano.jpg';

const SITE = await getSingleton('siteSettings');
const copy = await getSingleton('about');
const stats = copy.stats;
const faqs = await getOrderedCollection('faqsAbout');

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/about/#faq`,
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title={copy.seo.title}
  description={copy.seo.description}
  image={copy.seo.image}
  heroImage={venueInterior1.src}
  pageSchema={faqSchema}
>
  <Nav />

  <PageHero
    label={copy.hero.label}
    title={copy.hero.title}
    subtitle={copy.hero.subtitle}
    image={venueInterior1}
    imageAlt={copy.hero.imageAlt}
    overlay="gradient"
    align="bottom-left"
  />
  <TrustBar />

  <!-- CONCEPT SPLIT -->
  <section class="py-24 px-6">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <SectionHeader label={copy.concept.label} title={copy.concept.title} align="left" />
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-4" set:html={rawBlock(copy.concept.body[0])} />
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-4" set:html={rawBlock(copy.concept.body[1])} />
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed" set:html={rawBlock(copy.concept.body[2])} />
      </div>
      <div class="relative">
        <Image
          src={venueRoomPortrait}
          alt="The Lobby Tiki Bar full venue interior &mdash; bar, tiki atmosphere, Oceanside CA"
          class="w-full aspect-[4/5] object-cover"
          width={700} height={875}
        />
        <div class="absolute -top-4 -left-4 w-full h-full border border-[var(--color-teal)]/20 -z-10"></div>
      </div>
    </div>
  </section>

  <StatsBar stats={stats} background="jungle" />

  <IllustrationBand
    image={tikiIllustration}
    imageAlt="The Lobby Tiki Bar — craft tiki culture in Oceanside California"
    label={copy.illustration.label}
    title={copy.illustration.title}
    scriptLine={copy.illustration.scriptLine}
    subtitle={copy.illustration.subtitle}
    ctaLabel={copy.illustration.ctaLabel}
    ctaHref="/the-lobby"
    minHeight="55vh"
    overlayOpacity={72}
  />

  <!-- GPH SECTION -->
  <section class="py-24 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <SectionHeader label={copy.portfolio.label} title={copy.portfolio.title} />
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-4 max-w-2xl mx-auto" set:html={rawBlock(copy.portfolio.body[0])} />
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed max-w-2xl mx-auto" set:html={rawBlock(copy.portfolio.body[1])} />
    </div>
  </section>

  <FAQSection
    faqs={faqs}
    label={copy.faq.label}
    title={copy.faq.title}
    background="muted"
  />

  <CTASection
    title={copy.cta.title}
    subtitle={copy.cta.subtitle}
    primaryLabel={copy.cta.primaryLabel}
    primaryHref={SITE.reservations.url}
    secondaryLabel={copy.cta.secondaryLabel}
    secondaryHref={SITE.address.mapsUrl}
  />

  <Footer />
</BaseLayout>
