---
import { Image } from 'astro:assets';
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import TrustBar from "../components/TrustBar.astro";
import StatsBar from "../components/StatsBar.astro";
import SectionHeader from "../components/SectionHeader.astro";
import IllustrationBand from "../components/IllustrationBand.astro";
import CTASection from "../components/CTASection.astro";
import { getCollection, getEntry } from 'astro:content';
import FAQSection from '../components/FAQSection.astro';

import venueInterior1    from '../assets/images/venue-interior-1.jpg';
import venueRoomPortrait from '../assets/images/venue-room-portrait.jpg';
import tikiIllustration  from '../assets/images/tiki-illustration-volcano.jpg';

const SITE = (await getEntry('siteSettings', 'sitesettings'))!.data;
const content = (await getEntry('about', 'about'))!.data;
const stats = content.stats;
const faqs = (await getCollection('aboutFaqs')).sort((a, b) => a.id.localeCompare(b.id)).map((entry) => entry.data);

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/about/#faq`,
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  image={content.seo.image}
  heroImage={venueInterior1.src}
  pageSchema={faqSchema}
>
  <Nav />

  <PageHero
    label={content.hero.label}
    title={content.hero.title}
    subtitle={content.hero.subtitle}
    image={venueInterior1}
    imageAlt={content.hero.imageAlt}
    overlay="gradient"
    align="bottom-left"
  />
  <TrustBar />

  <!-- CONCEPT SPLIT -->
  <section class="py-24 px-6">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <SectionHeader label={content.concept.label} title={content.concept.title} align="left" />
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-4" set:html={`\n${content.concept.body[0]}\n`} />
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-4" set:html={`\n${content.concept.body[1]}\n`} />
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed" set:html={`\n${content.concept.body[2]}\n`} />
      </div>
      <div class="relative">
        <Image
          src={venueRoomPortrait}
          alt={content.concept.imageAlt}
          class="w-full aspect-[4/5] object-cover"
          width={700} height={875}
        />
        <div class="absolute -top-4 -left-4 w-full h-full border border-[var(--color-teal)]/20 -z-10"></div>
      </div>
    </div>
  </section>

  <StatsBar stats={stats} background="jungle" />

  <IllustrationBand
    image={tikiIllustration}
    imageAlt={content.illustration.imageAlt}
    label={content.illustration.label}
    title={content.illustration.title}
    scriptLine={content.illustration.scriptLine}
    subtitle={content.illustration.subtitle}
    ctaLabel="Explore the Venue"
    ctaHref="/the-lobby"
    minHeight="55vh"
    overlayOpacity={72}
  />

  <!-- GPH SECTION -->
  <section class="py-24 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <SectionHeader label={content.portfolio.label} title={content.portfolio.title} />
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-4 max-w-2xl mx-auto" set:html={`\n${content.portfolio.body[0]}\n`} />
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed max-w-2xl mx-auto" set:html={`\n${content.portfolio.body[1]}\n`} />
    </div>
  </section>

  <FAQSection
    faqs={faqs}
    label={content.faq.label}
    title={content.faq.title}
    background="muted"
  />

  <CTASection
    title={content.cta.title}
    subtitle={content.cta.subtitle}
    primaryLabel="Reserve a Table"
    primaryHref={SITE.reservations.url}
    secondaryLabel="Get Directions"
    secondaryHref={SITE.address.mapsUrl}
  />

  <Footer />
</BaseLayout>
