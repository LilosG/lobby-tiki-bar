---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getEntry } from 'astro:content';
const SITE = (await getEntry('siteSettings', 'sitesettings'))!.data;
const content = (await getEntry('reservations', 'reservations'))!.data;
const dayNames = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
const todayName = dayNames[new Date().getDay()];
---
<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
>
  <Nav />
  <section class="min-h-screen pt-32 pb-24 px-6 flex flex-col items-center justify-center text-center">
    <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">{content.hero.label}</p>
    <h1 class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl text-[var(--color-sand)] mb-4">{content.hero.title}</h1>
    <p class="font-[family-name:var(--font-script)] text-[var(--color-amber)] text-3xl mb-8">{content.hero.scriptLine}</p>
    <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 max-w-lg mx-auto mb-10 leading-relaxed" set:html={`\n${content.hero.body}\n`} />
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
      <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer"
        class="bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-sm tracking-widest uppercase px-10 py-4 hover:bg-[var(--color-sand)] transition-colors">
        Book Online
      </a>
      <a href={`tel:${SITE.phone.tel}`}
        class="border border-white/30 text-[var(--color-sand)] font-[family-name:var(--font-stamp)] text-sm tracking-widest uppercase px-10 py-4 hover:border-[var(--color-amber)] hover:text-[var(--color-amber)] transition-colors">
        {SITE.phone.display}
      </a>
    </div>
    <div class="w-full max-w-sm border border-white/10 p-8">
      <h2 class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-6">Hours</h2>
      <ul class="space-y-3">
        {SITE.hours.map((h) => (
          <li class:list={["flex justify-between font-[family-name:var(--font-body)] text-sm", h.day === todayName ? "text-[var(--color-sand)]" : "text-[var(--color-sand)] opacity-50"]}>
            <span>{h.day}</span>
            <span>{h.hours}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Footer />
</BaseLayout>
