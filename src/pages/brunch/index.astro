---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import { SITE } from '../../data/site';
import { BRUNCH } from '../../data/menu';

import brunchPlate2    from '../../assets/images/brunch-plate-2.jpg';
import drinkBarLifestyle from '../../assets/images/drink-bar-lifestyle.jpg';
import brunchPlate3    from '../../assets/images/brunch-plate-3.jpg';
import brunchPlate4    from '../../assets/images/brunch-plate-4.jpg';
import brunchPlate2    from '../../assets/images/brunch-plate-2.jpg';
import venueInterior3  from '../../assets/images/venue-interior-3.jpg';
---

<BaseLayout
  title="Brunch Oceanside | The Lobby Tiki Bar | Saturday & Sunday"
  description="Weekend brunch at The Lobby Tiki Bar in Oceanside CA. Saturday and Sunday 10 AM – 3 PM. Island-inspired brunch plates and tiki cocktails inside The Brick Hotel."
  image="/images/brunch-spread.jpg"
>
  <Nav />

  <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <Image src={brunchPlate2} alt="Weekend brunch at The Lobby Tiki Bar Oceanside"
        class="w-full h-full object-cover" width={1800} height={1000} loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-espresso)]/60 via-[var(--color-espresso)]/50 to-[var(--color-espresso)]"></div>
    </div>
    <div class="relative z-10 text-center px-6 max-w-3xl mx-auto">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-sm tracking-[0.3em] uppercase mb-6">Saturday & Sunday</p>
      <h1 class="font-[family-name:var(--font-display)] text-6xl sm:text-7xl lg:text-8xl text-[var(--color-sand)] leading-none mb-4">Brunch</h1>
      <p class="font-[family-name:var(--font-script)] text-[var(--color-amber)] text-3xl sm:text-4xl mb-6">at The Lobby</p>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)]/60 max-w-lg mx-auto leading-relaxed mb-10">
        Island-inspired brunch plates and craft tiki cocktails every Saturday and Sunday. Inside The Brick Hotel on Pier View Way.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer"
          class="bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-sm tracking-widest uppercase px-8 py-4 hover:bg-[var(--color-sand)] transition-colors">
          Reserve a Table
        </a>
        <a href="/menu"
          class="border border-[var(--color-sand)]/40 text-[var(--color-sand)] font-[family-name:var(--font-stamp)] text-sm tracking-widest uppercase px-8 py-4 hover:border-[var(--color-amber)] hover:text-[var(--color-amber)] transition-colors">
          View Full Menu
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-jungle)] border-y border-white/10">
    <div class="max-w-4xl mx-auto px-6 grid grid-cols-3 divide-x divide-white/10">
      <div class="text-center py-8 px-6">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">Days</p>
        <p class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)]">{SITE.brunch.days}</p>
      </div>
      <div class="text-center py-8 px-6">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">Hours</p>
        <p class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)]">{SITE.brunch.hours}</p>
      </div>
      <div class="text-center py-8 px-6">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-2">Location</p>
        <p class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)]">Pier View Way</p>
      </div>
    </div>
  </section>

  <section class="py-28 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">The Kitchen</p>
        <h2 class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl text-[var(--color-sand)]">Brunch Plates</h2>
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)]/60 mt-4 max-w-xl mx-auto leading-relaxed">
          Island-inspired morning plates. Built for the atmosphere, designed to hold up against the rum program.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {BRUNCH.map((item, i) => (
          <div class:list={[
            "group relative overflow-hidden border border-white/10 hover:border-[var(--color-amber)]/40 transition-colors duration-300",
            i === 0 ? "md:col-span-2 lg:col-span-1" : ""
          ]}>
            <div class="aspect-[4/3] overflow-hidden">
              <Image
                src={item.image}
                alt={`${item.name} at The Lobby Tiki Bar Oceanside brunch`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                width={600} height={450}
                loading={i === 0 ? "eager" : "lazy"}
              />
            </div>
            <div class="p-6">
              <h3 class="font-[family-name:var(--font-display)] text-xl text-[var(--color-sand)] mb-2">{item.name}</h3>
              <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)]/50 text-sm leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-white/10">
    <div class="grid lg:grid-cols-2 min-h-[600px]">
      <div class="bg-[var(--color-jungle)]/20 flex items-center px-10 py-16 lg:px-20 order-2 lg:order-1">
        <div class="max-w-md">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">Brunch Cocktails</p>
          <h2 class="font-[family-name:var(--font-display)] text-4xl text-[var(--color-sand)] mb-6">Tiki Before Noon</h2>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)]/70 leading-relaxed mb-6">
            The full cocktail program runs through brunch. Painkillers, Mai Tais, and the Cobra Kai don't care what time it is. Neither should you.
          </p>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)]/70 leading-relaxed mb-10">
            Weekend brunch is the right time to start with a Lobby Mai Tai and see where the afternoon takes you.
          </p>
          <a href="/menu#cocktails"
            class="inline-block border border-[var(--color-teal)] text-[var(--color-teal)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-teal)] hover:text-[var(--color-espresso)] transition-colors">
            Full Cocktail Menu
          </a>
        </div>
      </div>
      <div class="relative overflow-hidden min-h-[400px] order-1 lg:order-2">
        <Image src={drinkBarLifestyle} alt="Craft tiki cocktails at The Lobby Tiki Bar weekend brunch"
          class="w-full h-full object-cover absolute inset-0" width={900} height={900} />
        <div class="absolute inset-0 bg-[var(--color-espresso)]/30"></div>
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-[var(--color-espresso-light)]/20">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">The Setting</p>
        <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)]">Saturday & Sunday</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {[
          { img: brunchPlate3,   alt: 'Brunch plate at The Lobby Tiki Bar Oceanside'    },
          { img: brunchPlate4,   alt: 'Island brunch dish at The Lobby Oceanside'       },
          { img: venueInterior3, alt: 'The Lobby Tiki Bar interior Oceanside CA'        },
          { img: brunchPlate2,   alt: 'Weekend brunch at The Lobby Tiki Bar'            },
        ].map((item) => (
          <div class="aspect-square overflow-hidden">
            <Image src={item.img} alt={item.alt}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              width={400} height={400} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Join Us for Weekend Brunch"
    subtitle="Saturday & Sunday, 10 AM – 3 PM. 408 Pier View Way, Oceanside."
    primaryLabel="Reserve a Table"
    primaryHref={SITE.reservations.url}
    secondaryLabel="See Full Menu"
    secondaryHref="/menu"
    background="jungle"
  />

  <Footer />
</BaseLayout>
