---
import { Image } from 'astro:assets';
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import StatsBar from "../../components/StatsBar.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import IllustrationBand from "../../components/IllustrationBand.astro";
import CTASection from "../../components/CTASection.astro";
import { getCollection, getEntry } from 'astro:content';
import FAQSection from '../../components/FAQSection.astro';

import venueRoomFull      from '../../assets/images/venue-room-full.jpg';
import venueCurtainWide   from '../../assets/images/venue-curtain-wide.jpg';
import venueCurtainEdit   from '../../assets/images/venue-curtain-edit.jpg';
import venueBooth         from '../../assets/images/venue-booth-landscape.jpg';
import venueRoomPortrait  from '../../assets/images/venue-room-portrait.jpg';
import venueBoothPortrait from '../../assets/images/venue-booth-portrait.jpg';
import drinkCobraKai      from '../../assets/images/drink-cobra-kai.jpg';
import drinkDsc01014      from '../../assets/images/drink-dsc01014.jpg';
import drinkToucanSlam    from '../../assets/images/drink-toucan-slam.jpg';
import drinkDsc07144      from '../../assets/images/drink-dsc07144.jpg';
import tikiIllustration   from '../../assets/images/tiki-illustration-volcano.jpg';

const SITE = (await getEntry('siteSettings', 'sitesettings'))!.data;
const content = (await getEntry('venuePage', 'venuepage'))!.data;
const stats = content.stats ?? [];
const spaceBody = content.space?.body ?? [];
const spaceFeatures = content.space?.features ?? [];
const rumBody = content.rum?.body ?? [];
const venueGallery = [venueCurtainEdit, venueBooth, venueRoomPortrait, venueBoothPortrait]
  .map((img, index) => ({ img, alt: content.gallery?.alts?.[index] }))
  .filter((item): item is { img: typeof venueCurtainEdit; alt: string } => Boolean(item.alt));
const faqs = (await getCollection('venueFaqs')).sort((a, b) => a.id.localeCompare(b.id)).map((entry) => entry.data);

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/the-lobby/#faq`,
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  image={content.seo.image}
  heroImage={venueRoomFull.src}
  pageSchema={faqSchema}
>
  <Nav />

  <PageHero
    label={content.hero.label}
    title={content.hero.title}
    subtitle={content.hero.subtitle}
    image={venueRoomFull}
    imageAlt={content.hero.imageAlt}
    overlay="gradient"
    align="bottom-left"
  />
  <TrustBar />

  <!-- INTRO SPLIT -->
  <section class="py-24 px-6">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <SectionHeader label={content.space.label} title={content.space.title} align="left" />
        {spaceBody.map((paragraph: string, index: number) => (
          <p class:list={["font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed", index === spaceBody.length - 1 ? "mb-8" : "mb-4"]} set:html={`\n${paragraph}\n`} />
        ))}
        <ul class="space-y-3">
          {spaceFeatures.map((item: string) => (
            <li class="flex items-center gap-3 font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm">
              <span class="w-1.5 h-1.5 bg-[var(--color-amber)] rounded-full flex-shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="relative">
        <Image src={venueCurtainWide}
          alt={content.space.imageAlt}
          class="w-full aspect-[4/3] object-cover" width={900} height={675} />
        <div class="absolute -bottom-4 -right-4 w-full h-full border border-[var(--color-teal)]/20 -z-10"></div>
      </div>
    </div>
  </section>

  <StatsBar stats={stats} background="espresso" />

  <!-- RUM PROGRAM -->
  <section class="py-24 px-6 bg-[var(--color-jungle)]/20">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <SectionHeader label={content.rum.label} title={content.rum.title} align="left" />
        {rumBody.map((paragraph: string, index: number) => (
          <p class:list={["font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed", index === rumBody.length - 1 ? "mb-8" : "mb-4"]} set:html={`\n${paragraph}\n`} />
        ))}
        <a href="/menu"
          class="inline-block border border-[var(--color-teal)] text-[var(--color-teal)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-teal)] hover:text-[var(--color-espresso)] transition-colors">
          View the Full Menu
        </a>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <Image src={drinkCobraKai}   alt="Cobra Kai cocktail at The Lobby Tiki Bar Oceanside"       class="w-full aspect-square object-cover" width={350} height={350} />
        <Image src={drinkDsc01014}   alt="Lobby Mai Tai at The Lobby Tiki Bar Oceanside"            class="w-full aspect-square object-cover" width={350} height={350} />
        <Image src={drinkToucanSlam} alt="Toucan Slam at The Lobby Tiki Bar Oceanside"              class="w-full aspect-square object-cover" width={350} height={350} />
        <Image src={drinkDsc07144}   alt="Painkiller tiki cocktail at The Lobby Tiki Bar Oceanside" class="w-full aspect-square object-cover" width={350} height={350} />
      </div>
    </div>
  </section>

  <!-- VENUE GALLERY -->
  <section class="py-24 px-6">
    <div class="max-w-7xl mx-auto">
      <SectionHeader label={content.gallery.label} title={content.gallery.title} />
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {venueGallery.map((item) => (
          <div class="aspect-square overflow-hidden">
            <Image src={item.img} alt={item.alt}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              width={500} height={500} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <IllustrationBand
    image={tikiIllustration}
    imageAlt={content.illustration.imageAlt}
    label={content.illustration.label}
    title={content.illustration.title}
    scriptLine={content.illustration.scriptLine}
    subtitle={content.illustration.subtitle}
    ctaLabel="Reserve a Table"
    ctaHref={SITE.reservations.url}
    ctaExternal={true}
    minHeight="45vh"
    overlayOpacity={70}
  />

  <!-- LOCATION -->
  <section class="py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <SectionHeader label={content.location.label} title={content.location.title} />
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 mb-2">{SITE.address.full}</p>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-sm mb-8">{content.location.note}</p>
      <a href={SITE.address.mapsUrl} target="_blank" rel="noopener noreferrer"
        class="inline-block border border-[var(--color-amber)] text-[var(--color-amber)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-amber)] hover:text-[var(--color-espresso)] transition-colors">
        Get Directions
      </a>
    </div>
  </section>

  <FAQSection
    faqs={faqs}
    label={content.faq.label}
    title={content.faq.title}
    background="muted"
  />

  <CTASection
    title={content.cta.title}
    subtitle={content.cta.subtitle}
    primaryLabel="Reserve a Table"
    primaryHref={SITE.reservations.url}
    secondaryLabel="View the Menu"
    secondaryHref="/menu"
  />

  <Footer />
</BaseLayout>
