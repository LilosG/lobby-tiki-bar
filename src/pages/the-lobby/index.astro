---
import { Image } from 'astro:assets';
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import StatsBar from "../../components/StatsBar.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import IllustrationBand from "../../components/IllustrationBand.astro";
import CTASection from "../../components/CTASection.astro";
import { getOrderedCollection, getSingleton, rawBlock } from '../../lib/content';
import FAQSection from '../../components/FAQSection.astro';

import venueRoomFull      from '../../assets/images/venue-room-full.jpg';
import venueCurtainWide   from '../../assets/images/venue-curtain-wide.jpg';
import drinkCobraKai      from '../../assets/images/drink-cobra-kai.jpg';
import drinkDsc01014      from '../../assets/images/drink-dsc01014.jpg';
import drinkToucanSlam    from '../../assets/images/drink-toucan-slam.jpg';
import drinkDsc07144      from '../../assets/images/drink-dsc07144.jpg';
import tikiIllustration   from '../../assets/images/tiki-illustration-volcano.jpg';

const SITE = await getSingleton('siteSettings');
const copy = await getSingleton('venuePage');
const stats = copy.stats;
const faqs = await getOrderedCollection('faqsVenue');

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE.url}/the-lobby/#faq`,
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title={copy.seo.title}
  description={copy.seo.description}
  image={copy.seo.image}
  heroImage={venueRoomFull.src}
  pageSchema={faqSchema}
>
  <Nav />

  <PageHero
    label={copy.hero.label}
    title={copy.hero.title}
    subtitle={copy.hero.subtitle}
    image={venueRoomFull}
    imageAlt={copy.hero.imageAlt}
    overlay="gradient"
    align="bottom-left"
  />
  <TrustBar />

  <!-- INTRO SPLIT -->
  <section class="py-24 px-6">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <SectionHeader label={copy.intro.label} title={copy.intro.title} align="left" />
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-4" set:html={rawBlock(copy.intro.body[0])} />
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-8" set:html={rawBlock(copy.intro.body[1])} />
        <ul class="space-y-3">
          {copy.intro.features.map((item: string) => (
            <li class="flex items-center gap-3 font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 text-sm">
              <span class="w-1.5 h-1.5 bg-[var(--color-amber)] rounded-full flex-shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="relative">
        <Image src={venueCurtainWide}
          alt="The Lobby Tiki Bar Oceanside CA &mdash; beaded curtains, tiki carvings, booth seating"
          class="w-full aspect-[4/3] object-cover" width={900} height={675} />
        <div class="absolute -bottom-4 -right-4 w-full h-full border border-[var(--color-teal)]/20 -z-10"></div>
      </div>
    </div>
  </section>

  <StatsBar stats={stats} background="espresso" />

  <!-- RUM PROGRAM -->
  <section class="py-24 px-6 bg-[var(--color-jungle)]/20">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <SectionHeader label={copy.rum.label} title={copy.rum.title} align="left" />
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-4" set:html={rawBlock(copy.rum.body[0])} />
        <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed mb-8" set:html={rawBlock(copy.rum.body[1])} />
        <a href="/menu"
          class="inline-block border border-[var(--color-teal)] text-[var(--color-teal)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-teal)] hover:text-[var(--color-espresso)] transition-colors" set:html={rawBlock(copy.rum.cta)} />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <Image src={drinkCobraKai}   alt="Cobra Kai cocktail at The Lobby Tiki Bar Oceanside"       class="w-full aspect-square object-cover" width={350} height={350} />
        <Image src={drinkDsc01014}   alt="Lobby Mai Tai at The Lobby Tiki Bar Oceanside"            class="w-full aspect-square object-cover" width={350} height={350} />
        <Image src={drinkToucanSlam} alt="Toucan Slam at The Lobby Tiki Bar Oceanside"              class="w-full aspect-square object-cover" width={350} height={350} />
        <Image src={drinkDsc07144}   alt="Painkiller tiki cocktail at The Lobby Tiki Bar Oceanside" class="w-full aspect-square object-cover" width={350} height={350} />
      </div>
    </div>
  </section>

  <!-- VENUE GALLERY -->
  <section class="py-24 px-6">
    <div class="max-w-7xl mx-auto">
      <SectionHeader label={copy.gallery.label} title={copy.gallery.title} />
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {copy.gallery.items.map((item: any) => (
          <div class="aspect-square overflow-hidden">
            <Image src={item.image} alt={item.alt}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              width={500} height={500} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <IllustrationBand
    image={tikiIllustration}
    imageAlt="The Lobby Tiki Bar — craft tiki destination in Oceanside California"
    label={copy.illustration.label}
    title={copy.illustration.title}
    scriptLine={copy.illustration.scriptLine}
    subtitle={copy.illustration.subtitle}
    ctaLabel={copy.illustration.ctaLabel}
    ctaHref={SITE.reservations.url}
    ctaExternal={true}
    minHeight="45vh"
    overlayOpacity={70}
  />

  <!-- LOCATION -->
  <section class="py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <SectionHeader label={copy.location.label} title={copy.location.title} />
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 mb-2">{SITE.address.full}</p>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-sm mb-8">{copy.location.note}</p>
      <a href={SITE.address.mapsUrl} target="_blank" rel="noopener noreferrer"
        class="inline-block border border-[var(--color-amber)] text-[var(--color-amber)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-amber)] hover:text-[var(--color-espresso)] transition-colors" set:html={rawBlock(copy.location.cta)} />
    </div>
  </section>

  <FAQSection
    faqs={faqs}
    label={copy.faq.label}
    title={copy.faq.title}
    background="muted"
  />

  <CTASection
    title={copy.cta.title}
    subtitle={copy.cta.subtitle}
    primaryLabel={copy.cta.primaryLabel}
    primaryHref={SITE.reservations.url}
    secondaryLabel={copy.cta.secondaryLabel}
    secondaryHref="/menu"
  />

  <Footer />
</BaseLayout>
