---
import { getEntry } from 'astro:content';
import Button from './Button.astro';
const SITE = (await getEntry('siteSettings', 'sitesettings'))!.data;
interface Props {
  title?: string;
  subtitle?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  background?: "jungle" | "espresso" | "amber";
}
const {
  title = "Ready to Visit?",
  subtitle = "Reserve your table or come on in.",
  primaryLabel = "Reserve a Table",
  primaryHref = SITE.reservations.url,
  secondaryLabel,
  secondaryHref,
  background = "jungle",
} = Astro.props;
const bgClass = { jungle: "bg-[var(--color-jungle)]/30", espresso: "bg-[var(--color-espresso-light)]/20", amber: "bg-[var(--color-amber)]/10" }[background];
---
<section class:list={["py-20 px-6 text-center", bgClass]}>
  <div class="max-w-2xl mx-auto">
    <h2 class="font-[family-name:var(--font-display)] text-3xl sm:text-4xl text-[var(--color-sand)] mb-4">{title}</h2>
    {subtitle && <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 mb-8 leading-relaxed">{subtitle}</p>}
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <Button href={primaryHref} external={primaryHref.startsWith('http')}>{primaryLabel}</Button>
      {secondaryLabel && secondaryHref && <Button href={secondaryHref} variant="outline" external={secondaryHref.startsWith('http')}>{secondaryLabel}</Button>}
    </div>
  </div>
</section>
