---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  label?: string;
  title: string;
  scriptLine?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaExternal?: boolean;
  minHeight?: string;
  overlayOpacity?: number;
}
const {
  image, imageAlt, label, title, scriptLine, subtitle,
  ctaLabel, ctaHref, ctaExternal = false,
  minHeight = '50vh', overlayOpacity = 70,
} = Astro.props;
const overlayStyle = `background-color: rgba(44,26,14,${overlayOpacity / 100})`;
---
<section class="relative flex items-center justify-center overflow-hidden"
  style={`min-height: ${minHeight}`}>
  <div class="absolute inset-0">
    <Image src={image} alt={imageAlt}
      class="w-full h-full object-cover object-center"
      width={1080} height={1320} />
    <div class="absolute inset-0" style={overlayStyle}></div>
  </div>
  <div class="relative z-10 text-center px-6 py-20 max-w-2xl mx-auto">
    {label && (
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-6">{label}</p>
    )}
    <h2 class="font-[family-name:var(--font-display)] text-5xl sm:text-6xl text-[var(--color-sand)] leading-tight mb-2">{title}</h2>
    {scriptLine && (
      <p class="font-[family-name:var(--font-script)] text-[var(--color-amber)] text-5xl sm:text-6xl mb-6">{scriptLine}</p>
    )}
    {subtitle && (
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-70 leading-relaxed max-w-lg mx-auto mb-10">{subtitle}</p>
    )}
    {ctaLabel && ctaHref && (
      <a href={ctaHref}
        target={ctaExternal ? '_blank' : undefined}
        rel={ctaExternal ? 'noopener noreferrer' : undefined}
        class="inline-block bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase px-8 py-3 hover:bg-[var(--color-sand)] transition-colors">
        {ctaLabel}
      </a>
    )}
  </div>
</section>
