---
import { getEntry } from 'astro:content';
const SITE = (await getEntry('siteSettings', 'sitesettings'))!.data;
---
<div class="fixed bottom-0 left-0 right-0 z-50 lg:hidden">
  <div class="grid grid-cols-2 border-t border-white/20 bg-[var(--color-espresso)]/95 backdrop-blur-sm">
    <a href={SITE.reservations.url}
      target="_blank" rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 py-4 bg-[var(--color-amber)] text-[var(--color-espresso)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase hover:bg-[var(--color-sand)] transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      Reserve
    </a>
    <a href={`tel:${SITE.phone.tel}`}
      class="flex items-center justify-center gap-2 py-4 text-[var(--color-sand)] font-[family-name:var(--font-stamp)] text-xs tracking-widest uppercase hover:text-[var(--color-amber)] transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      Call Us
    </a>
  </div>
</div>
