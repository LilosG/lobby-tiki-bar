---
interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = "Request Your Event",
  subtitle = "Tell us about your group, occasion, and date. We'll put together a package that works.",
} = Astro.props;
---

<section class="py-24 px-6" id="book-event">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">Get Started</p>
      <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)] mb-4">{title}</h2>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 leading-relaxed max-w-xl mx-auto">{subtitle}</p>
    </div>

    <div class="relative border border-white/10 overflow-hidden" id="catering-frame-wrap">
      <div id="catering-loader"
        class="absolute inset-0 flex items-center justify-center bg-[var(--color-espresso)] z-10 transition-opacity duration-500">
        <div class="text-center">
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-widest uppercase mb-3">Loading</p>
          <div class="w-8 h-8 border-2 border-[var(--color-amber)]/30 border-t-[var(--color-amber)] rounded-full animate-spin mx-auto"></div>
        </div>
      </div>
      <iframe
        id="catering-iframe"
        src="https://www.toasttab.com/invoice/lead?rx=92e5306b-e932-4406-876b-91277626cb5c&ot=fb59fde7-2560-4025-bb15-abbd63a46f88"
        width="100%"
        height="800"
        style="border:0; display:block; filter: invert(1) hue-rotate(180deg) brightness(0.85) contrast(0.9);"
        loading="lazy"
        title="Private Event Inquiry — The Lobby Tiki Bar"
        allow="payment"
        onload="
          document.getElementById('catering-loader').style.opacity='0';
          setTimeout(() => document.getElementById('catering-loader').style.display='none', 500);
        "
      ></iframe>
    </div>

    <p class="text-center font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-xs mt-4">
      Prefer to reach us directly?
      <a href="mailto:info@lobbytikibar.com" class="hover:text-[var(--color-amber)] transition-colors underline">info@lobbytikibar.com</a>
      &nbsp;&middot;&nbsp;
      <a href="tel:+18583047725" class="hover:text-[var(--color-amber)] transition-colors underline">(858) 304-7725</a>
    </p>
  </div>
</section>
