---
interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = "Request Your Event",
  subtitle = "Tell us about your group, occasion, and date. We’ll put together a package that works.",
} = Astro.props;
---

<section class="py-24 px-6 bg-[var(--color-espresso-light)]/20" id="book-event">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.3em] uppercase mb-4">Get Started</p>
      <h2 class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl text-[var(--color-sand)] mb-4">{title}</h2>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-60 leading-relaxed max-w-xl mx-auto">{subtitle}</p>
    </div>

    <div class="border border-white/10 overflow-hidden">
      <iframe
        src="https://www.toasttab.com/catering/the-brick-project-408-pier-view-way"
        width="100%"
        height="900"
        style="border:0; display:block;"
        loading="lazy"
        title="Private Event Inquiry — The Lobby Tiki Bar"
        allow="payment"
      ></iframe>
    </div>

    <div class="mt-8 grid md:grid-cols-2 gap-4">
      <a href="mailto:info@lobbytikibar.com?subject=Private Event Inquiry"
        class="group flex items-center gap-6 border border-white/10 p-6 hover:border-[var(--color-amber)]/40 transition-colors">
        <div class="w-10 h-10 border border-[var(--color-amber)]/30 flex items-center justify-center flex-shrink-0 group-hover:border-[var(--color-amber)] transition-colors">
          <svg class="w-4 h-4 text-[var(--color-amber)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-sand)] text-xs tracking-widest uppercase mb-1">Prefer Email</p>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm">info@lobbytikibar.com</p>
        </div>
      </a>
      <a href="tel:+18583047725"
        class="group flex items-center gap-6 border border-white/10 p-6 hover:border-[var(--color-amber)]/40 transition-colors">
        <div class="w-10 h-10 border border-[var(--color-amber)]/30 flex items-center justify-center flex-shrink-0 group-hover:border-[var(--color-amber)] transition-colors">
          <svg class="w-4 h-4 text-[var(--color-amber)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <div>
          <p class="font-[family-name:var(--font-stamp)] text-[var(--color-sand)] text-xs tracking-widest uppercase mb-1">Call Us</p>
          <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-50 text-sm">(858) 304-7725</p>
        </div>
      </a>
    </div>
  </div>
</section>
