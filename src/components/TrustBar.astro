---
import { getEntry } from 'astro:content';

const SITE = (await getEntry('siteSettings', 'sitesettings'))!.data;

const dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const todayName = dayNames[new Date().getDay()];
const todayHours = (SITE.hours ?? []).find(h => h.day === todayName)?.hours ?? 'Closed';
---
<section class="bg-[var(--color-jungle)] border-b border-white/10">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 lg:grid-cols-4 divide-x divide-white/10">
    <div class="text-center py-6 px-4">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.2em] uppercase mb-1">Hours Today</p>
      <p data-hours-today class="font-[family-name:var(--font-body)] text-[var(--color-sand)] text-sm">{todayHours}</p>
    </div>
    <div class="text-center py-6 px-4">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.2em] uppercase mb-1">Happy Hour</p>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] text-sm">{SITE.happyHour.days}</p>
      <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] text-xs opacity-60">{SITE.happyHour.hours}</p>
    </div>
    <div class="text-center py-6 px-4">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.2em] uppercase mb-1">Location</p>
      <a href={SITE.address.mapsUrl} target="_blank" rel="noopener noreferrer"
        class="font-[family-name:var(--font-body)] text-[var(--color-sand)] text-sm hover:text-[var(--color-amber)] transition-colors">
        {SITE.address.street}, Oceanside
      </a>
    </div>
    <div class="text-center py-6 px-4">
      <p class="font-[family-name:var(--font-stamp)] text-[var(--color-amber)] text-xs tracking-[0.2em] uppercase mb-1">Reservations</p>
      <a href={SITE.reservations.url} target="_blank" rel="noopener noreferrer"
        class="font-[family-name:var(--font-body)] text-[var(--color-sand)] text-sm hover:text-[var(--color-amber)] transition-colors">
        Book Online
      </a>
    </div>
  </div>
</section>
