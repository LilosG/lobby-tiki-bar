---
interface StatItem {
  value: string;
  label: string;
  note?: string;
}
interface Props {
  stats: StatItem[];
  background?: 'jungle' | 'espresso';
}
const { stats, background = 'jungle' } = Astro.props;
const bgClass = {
  jungle:   'bg-[var(--color-jungle)]/30',
  espresso: 'bg-[var(--color-espresso-light)]/20',
}[background];
---
<section class:list={["py-16 px-6", bgClass]}>
  <div class="max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-px bg-white/10">
    {stats.map((s) => (
      <div class="bg-[var(--color-espresso)] py-10 px-6 text-center">
        <p class="font-[family-name:var(--font-display)] text-3xl sm:text-4xl text-[var(--color-amber)] mb-2">{s.value}</p>
        <p class="font-[family-name:var(--font-stamp)] text-[var(--color-sand)] opacity-50 text-xs tracking-widest uppercase">{s.label}</p>
        {s.note && <p class="font-[family-name:var(--font-body)] text-[var(--color-sand)] opacity-40 text-xs mt-1">{s.note}</p>}
      </div>
    ))}
  </div>
</section>
