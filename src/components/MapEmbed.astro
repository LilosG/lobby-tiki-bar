---
interface Props {
  src: string;
  title: string;
  containerClass?: string;
  style?: string;
}

const {
  src,
  title,
  containerClass = 'w-full aspect-square overflow-hidden border border-white/10',
  style = 'border:0;',
} = Astro.props;
---

<div class={containerClass} data-map-embed>
  <div class="map-placeholder">
    <p class="map-notice">Loading this map connects to Google.</p>
    <button type="button" class="map-load-btn" aria-label={`Load map: ${title}`}>
      Load map
    </button>
  </div>
</div>

<style>
  [data-map-embed] {
    position: relative;
  }

  .map-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    height: 100%;
    min-height: 240px;
    background-color: var(--color-espresso-light, #4A2E18);
    border: 1px solid rgba(245, 230, 200, 0.1);
  }

  .map-notice {
    margin: 0;
    font-size: 0.75rem;
    color: rgba(245, 230, 200, 0.5);
    font-family: var(--font-body, sans-serif);
    text-align: center;
    padding: 0 1rem;
  }

  .map-load-btn {
    font-family: var(--font-stamp, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.625rem 1.5rem;
    background-color: var(--color-amber, #E8863A);
    color: var(--color-espresso, #2C1A0E);
    border: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .map-load-btn:hover {
    background-color: var(--color-sand, #F5E6C8);
  }

  .map-load-btn:focus-visible {
    outline: 2px solid var(--color-amber, #E8863A);
    outline-offset: 2px;
  }

  [data-map-embed] iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script is:inline define:vars={{ src, title, style }}>
  (function () {
    var wrapper = document.currentScript.previousElementSibling;
    if (!wrapper) return;
    var btn = wrapper.querySelector('.map-load-btn');
    if (!btn) return;

    btn.addEventListener('click', function () {
      var iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = title;
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer';
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('style', style);
      wrapper.innerHTML = '';
      wrapper.appendChild(iframe);
    }, { once: true });
  })();
</script>
